---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Skills — Luis Meyehen Paz"
  description="The stack I run every day, as a process view — no self-assigned scores, just what's loaded."
  session="htop"
  footPrompt="$ htop -d 10 ▮"
>
  <main class="screen sess-main">
    <div class="container screen-inner">
      <div class="screen-head">
        <p class="eyebrow">htop · skills</p>
        <h2>What's loaded right now.</h2>
        <p>The stack I run every day, as a process view — no self-assigned scores, just what's loaded.</p>
      </div>

      <div class="terminal htop">
        <div class="term-bar">
          <span class="term-dot" aria-hidden="true"></span>
          <span class="term-dot" aria-hidden="true"></span>
          <span class="term-dot" aria-hidden="true"></span>
          <span class="term-title">htop — luis@cloud</span>
        </div>

        <div class="htop-summary">
          <span><span class="val">6</span> skills loaded</span>
          <span>cloud → platform → data → ai</span>
        </div>

        <div class="htop-head" aria-hidden="true">
          <span>pid</span><span>skill</span><span>stack</span>
        </div>

        <div class="htop-row">
          <span class="htop-pid">01</span>
          <span class="htop-skill">Cloud &amp; IaC</span>
          <span class="htop-stack">AWS · Terraform · AWS CDK · CloudFormation</span>
        </div>

        <div class="htop-row">
          <span class="htop-pid">02</span>
          <span class="htop-skill">CI/CD &amp; DevOps</span>
          <span class="htop-stack">GitHub Actions · GitLab CI · Docker · Git</span>
        </div>

        <div class="htop-row">
          <span class="htop-pid">03</span>
          <span class="htop-skill">Platform Engineering</span>
          <span class="htop-stack">Internal Developer Platforms · Observability · Cost Management · Developer Enablement</span>
        </div>

        <div class="htop-row">
          <span class="htop-pid">04</span>
          <span class="htop-skill">Data Engineering</span>
          <span class="htop-stack">ETL Pipelines · SQL · PySpark · Databricks · Trino</span>
        </div>

        <div class="htop-row">
          <span class="htop-pid">05</span>
          <span class="htop-skill">AI Tooling</span>
          <span class="htop-stack">MCP · Agent Orchestration · Multi-agent Workflows · AWS Bedrock</span>
        </div>

        <div class="htop-row">
          <span class="htop-pid">06</span>
          <span class="htop-skill">Python</span>
          <span class="htop-stack">Python · Pandas · NumPy · Boto3 · FastAPI</span>
        </div>

        <div class="htop-foot">
          <span>[ 1–6 of 6 ]</span>
          <span>htop 3.3.0 · luis@cloud</span>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
