---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionPanel from '../components/SectionPanel.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('now', 'now');
if (!entry) throw new Error('now/now.md missing');

const { Content } = await render(entry);
const updated = entry.data.updated;
const formattedDate = updated.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title="/now — Luis Meyehen Paz">
  <SectionPanel title="/now">
    <p class="font-mono text-xs text-[var(--color-text-muted)] mb-6">
      Last updated: {formattedDate}
    </p>
    <article class="prose-content">
      <Content />
    </article>
  </SectionPanel>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  .prose-content :global(p),
  .prose-content :global(li) {
    color: var(--color-text);
    line-height: 1.7;
  }
  .prose-content :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0 1rem;
  }
  .prose-content :global(li) {
    margin: 0.25rem 0;
  }
  .prose-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose-content :global(a) {
    color: var(--color-accent);
  }
</style>
