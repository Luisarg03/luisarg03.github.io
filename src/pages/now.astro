---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionPanel from '../components/layout/SectionPanel.astro';
import StatusIndicator from '../components/ui/StatusIndicator.astro';
import Card from '../components/ui/Card.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('now', 'now');
if (!entry) throw new Error('now/now.md missing');

const { Content } = await render(entry);
const updated = entry.data.updated;
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const formattedDate = `${MONTHS[updated.getUTCMonth()]} ${updated.getUTCDate()}, ${updated.getUTCFullYear()}`;

const focusStatusMap: Record<string, 'active' | 'in-progress' | 'planned' | 'offline'> = {
  'in-progress': 'in-progress',
  planned: 'planned',
  paused: 'offline',
  completed: 'active',
};
---

<BaseLayout title="/now — Luis Meyehen Paz">
  <div class="mb-4">
    <div class="flex items-center gap-3 mb-2">
      <StatusIndicator status="active" label="operational" />
      <span class="h-px flex-1 bg-[var(--color-border)]"></span>
    </div>
    <p class="font-mono text-xs text-[var(--color-text-muted)]">
      Last updated: {formattedDate}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4 stagger">
    {entry.data.focus.map((item) => (
      <Card variant="status">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-xs uppercase tracking-wider text-[var(--color-text-muted)]">
            {item.label}
          </span>
          <StatusIndicator status={focusStatusMap[item.status] ?? 'planned'} />
        </div>
        {item.progress !== undefined && (
          <div class="progress-bar mb-2">
            <div class="progress-bar__fill" style={`width: ${item.progress}%`}></div>
          </div>
        )}
        {item.note && (
          <p class="font-mono text-xs text-[var(--color-text-muted)]" style="line-height: 1.6">{item.note}</p>
        )}
      </Card>
    ))}
  </div>

  <SectionPanel title="/now" class="noise-overlay">
    <Card variant="status">
      <article class="prose-content">
        <Content />
      </article>
    </Card>
  </SectionPanel>
</BaseLayout>

<style>
  /* ── Prose content styles ──────────────────────────────────────────── */
  .prose-content :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prose-content :global(h2)::before {
    content: '›';
    color: var(--color-accent);
    font-weight: 700;
  }

  .prose-content :global(p),
  .prose-content :global(li) {
    color: var(--color-text);
    line-height: 1.7;
    font-size: var(--text-sm);
  }

  .prose-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin: 0.375rem 0 0.75rem;
  }

  .prose-content :global(li) {
    margin: 0.25rem 0;
    padding-left: 1rem;
    position: relative;
  }

  .prose-content :global(li)::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 600;
  }

  .prose-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .prose-content :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }
</style>
