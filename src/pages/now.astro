---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionPanel from '../components/layout/SectionPanel.astro';
import StatusIndicator from '../components/ui/StatusIndicator.astro';
import Card from '../components/ui/Card.astro';
import { getEntry, render, getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const entry = await getEntry('now', 'now');
if (!entry) throw new Error('now/now.md missing');

const { Content } = await render(entry);
const updated = entry.data.updated;
// YAML date parses as midnight UTC; format with UTC getters so the intended
// calendar day is preserved regardless of the server's timezone (toLocaleDateString
// shifts the day back in negative-offset zones).
const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
const formattedDate = `${MONTHS[updated.getUTCMonth()]} ${updated.getUTCDate()}, ${updated.getUTCFullYear()}`;

// server-side load travel entries in frontmatter so template can render
const _travelEntries = (await getCollection('travel')) || [];
// cast to Array<any> to avoid narrow generated types when collection empty
const travelSorted = /** @type {Array<any>} */ (_travelEntries).slice().sort((a, b) => {
  const da = a && a.data && a.data.date ? a.data.date.getTime() : 0;
  const db = b && b.data && b.data.date ? b.data.date.getTime() : 0;
  return db - da;
});

// StatusIndicator supports active|in-progress|planned|offline; map focus statuses, fallback to planned
const focusStatusMap: Record<string, 'active' | 'in-progress' | 'planned' | 'offline'> = {
  'in-progress': 'in-progress',
  planned: 'planned',
  paused: 'offline',
  completed: 'active',
};
---

<BaseLayout title="/now — Luis Meyehen Paz">
  <!-- System status header -->
  <div class="mb-4">
    <div class="flex items-center gap-3 mb-2">
      <StatusIndicator status="active" label="operational" />
      <span class="h-px flex-1 bg-[var(--color-border)]"></span>
    </div>
    <p class="font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]">
      Last updated: {formattedDate}
    </p>
  </div>

  <!-- Focus cards — render from frontmatter -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-4 stagger">
    {entry.data.focus.map((item) => (
      <Card variant="status">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-[var(--text-xs)] uppercase tracking-wider text-[var(--color-text-muted)]">
            {item.label}
          </span>
          <StatusIndicator status={focusStatusMap[item.status] ?? 'planned'} />
        </div>
        {item.progress !== undefined && (
          <div class="progress-bar mb-2">
            <div class="progress-bar__fill" style={`width: ${item.progress}%`}></div>
          </div>
        )}
        {item.note && (
          <p class="font-mono text-[10px] text-[var(--color-text-muted)]">{item.note}</p>
        )}
      </Card>
    ))}

    <!-- Travel log (only when travel collection has entries) -->
    {travelSorted.length > 0 && (
      <Card variant="status">
        <div class="flex items-center justify-between mb-3">
          <span class="font-mono text-[var(--text-xs)] uppercase tracking-wider text-[var(--color-text-muted)]">
            Travel log
          </span>
          <StatusIndicator status="planned" />
        </div>

        ---

        <!-- Travel entries: render as journalctl-style rows, collapsed by default -->
        <div class="travel-log mt-2">
          <div class="font-mono text-[var(--text-xs)]">
            {travelSorted.map((e: any, idx: number) => {
              const id = `travel-detail-${idx}`;
              const date = e.data.date.toISOString().slice(0,10);
              return (
                <div class="travel-entry" style="border-left:2px solid var(--color-border); padding:0.5rem 0.5rem; margin-left:0.5rem">
                  <div class="travel-entry-header" style="display:flex;gap:0.5rem;align-items:center;">
                    <span class="travel-date text-[var(--color-text-muted)]">[{date}]</span>
                    <span class="travel-location text-[var(--color-accent)]">{(e as any).data.location}</span>
                    <span class="travel-caption text-[var(--color-text)]">{(e as any).data.caption}</span>
                    {(e as any).data.photos && (e as any).data.photos.length > 0 && (
                      <button class="travel-toggle" aria-expanded="false" aria-controls={id} style="margin-left:auto;background:none;border:none;color:var(--color-accent);font-family:var(--font-mono);cursor:pointer;">Show photos</button>
                    )}
                  </div>

                  {(e as any).data.photos && (e as any).data.photos.length > 0 && (
                    <div id={id} class="travel-details" role="region" aria-label={`Photos for ${(e as any).data.location}`} hidden>
                      <div style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-top:0.5rem;">
                        {(e as any).data.photos.map((p: any) => (
                          <Image src={p} alt={(e as any).data.caption} width={240} height={160} />
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </Card>
    )}
  </div>

  <!-- Main content -->
  <SectionPanel title="/now" class="noise-overlay">
    <Card variant="status">
      <article class="prose-content">
        <Content />
      </article>
    </Card>
  </SectionPanel>
</BaseLayout>

<style>
  .prose-content :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-text-muted);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .prose-content :global(h2)::before {
    content: '›';
    color: var(--color-accent);
    font-weight: 700;
  }

  .prose-content :global(p),
  .prose-content :global(li) {
    color: var(--color-text);
    line-height: 1.7;
    font-size: var(--text-sm);
  }

  .prose-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin: 0.375rem 0 0.75rem;
  }

  .prose-content :global(li) {
    margin: 0.25rem 0;
    padding-left: 1rem;
    position: relative;
  }

  .prose-content :global(li)::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--color-accent);
    font-weight: 600;
  }

  .prose-content :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .prose-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .prose-content :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }
</style>

<script>
  // @ts-nocheck
  (function () {
    document.addEventListener('click', function (event) {
      var btn = event.target.closest ? event.target.closest('.travel-toggle') : null;
      if (!btn) return;

      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var id = btn.getAttribute('aria-controls');
      var panel = id ? document.getElementById(id) : null;
      if (!panel) return;

      btn.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;

      var label = btn.querySelector('.travel-toggle-label');
      if (label) {
        label.textContent = expanded ? 'Show photos' : 'Hide photos';
      } else {
        // toggle simple text when no inner label
        btn.textContent = expanded ? 'Show photos' : 'Hide photos';
      }
    });
  })();
</script>
