---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermWindow from '../components/terminal/TermWindow.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import mobileShot from '../assets/projects/tabimichi/mobile.png';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const [featured, ...rest] = projects;
const f = featured?.data as any;

// Terminal title bar slug: "OpenDashboard" → "opendashboard"
function slugify(title: string): string {
  return title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
}
---

<BaseLayout
  title="Projects — Luis Meyehen Paz"
  description="Selected projects — knowledge systems, infrastructure, and tooling."
  session="projects"
  footPrompt="$ ls ~/projects ▮"
>
  <main class="screen sess-main">
    <div class="container screen-inner">
      <div class="screen-head">
        <p class="eyebrow">showcase · selected work</p>
        <h2>Proof you can open.</h2>
        <p>Each project in its native window — a real screenshot for the apps, a terminal for the CLI. Nothing staged.</p>
      </div>

      <!-- Featured: Tabimichi -->
      {featured && (
        <article class="showcase-featured">
          <div class="showcase-copy">
            <span class="pill">featured</span>
            <h3>{f.title}</h3>
            <p class="project-desc">{f.description}</p>
            {f.impact && f.impact.length > 0 && (
              <p class="project-impact">→ {f.impact.slice(0, 2).join('; ')}</p>
            )}
            <div class="project-tags">
              {f.tags.map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
            <a class="project-link" href={f.repo} target="_blank" rel="noopener noreferrer">github ↗</a>
          </div>

          <div class="showcase-visual">
            <figure class="shot-frame">
              <div class="shot-bar">
                <span class="term-dot" aria-hidden="true"></span>
                <span class="term-dot" aria-hidden="true"></span>
                <span class="term-dot" aria-hidden="true"></span>
                <span class="term-title">tabimichi.vercel.app</span>
              </div>
              {f.cover && <Image class="shot-img" src={f.cover} alt={f.coverAlt ?? f.title} />}
            </figure>
            <figure class="shot-frame shot-frame--phone" aria-hidden="true">
              <Image class="shot-img" src={mobileShot} alt="" />
            </figure>
          </div>
        </article>
      )}

      <div class="grid-2">
        {rest.map((project) => {
          const d = project.data as any;
          const hasCover = !!d.cover;
          const snippet = d.codeSnippet ? d.codeSnippet.code.split('\n').slice(0, 4).join('\n') : null;
          const barTitle = hasCover ? slugify(d.title) : `${slugify(d.title)} — ${d.codeSnippet?.lang ?? 'shell'}`;
          return (
            <article class="card project-card">
              {hasCover ? (
                <figure class="shot-frame">
                  <div class="shot-bar">
                    <span class="term-dot" aria-hidden="true"></span>
                    <span class="term-dot" aria-hidden="true"></span>
                    <span class="term-dot" aria-hidden="true"></span>
                    <span class="term-title">{barTitle}</span>
                  </div>
                  <Image class="shot-img" src={d.cover} alt={d.coverAlt ?? d.title} />
                </figure>
              ) : (
                snippet && (
                  <TermWindow title={barTitle}>
                    <code style="color: var(--fg);">{snippet}</code>
                  </TermWindow>
                )
              )}
              <h3>{d.title}</h3>
              <p class="project-desc">{d.description}</p>
              {d.impact && d.impact.length > 0 && (
                <p class="project-impact">→ {d.impact[0]}</p>
              )}
              <div class="project-tags">
                {d.tags.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
              <a class="project-link" href={d.repo} target="_blank" rel="noopener noreferrer">github ↗</a>
            </article>
          );
        })}
      </div>
    </div>
  </main>
</BaseLayout>
