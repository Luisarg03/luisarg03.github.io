---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionPanel from '../components/layout/SectionPanel.astro';
import { getCollection } from 'astro:content';

// Heuristic: prefer projects with explicit impact arrays and larger impact counts.
// Fallback: extract first number from first impact line if present, otherwise fallback to `order`.
function impactScore(a: any) {
  const data = a.data || {};
  if (data.impact && data.impact.length) return data.impact.length * 100;
  if (data.impact && data.impact[0]) {
    const m = data.impact[0].match(/(\d+(?:\.\d+)?)/);
    if (m) return parseFloat(m[1]) * 10;
  }
  return data.order || 0;
}

const projects = (await getCollection('projects'))
  .sort((a, b) => impactScore(b) - impactScore(a) || (a.data.order - b.data.order));
---

<BaseLayout
  title="/projects — Luis Meyehen Paz"
  description="Selected projects — knowledge systems, infrastructure, and tooling."
>
  <SectionPanel title="/projects" class="noise-overlay">
    {projects.length === 0 ? (
      <p class="font-mono text-[var(--text-sm)] text-[var(--color-text-muted)]">No projects yet.</p>
    ) : (
      <div class="projects-grid">
        {projects.map((project, idx) => {
          const data = project.data as any;
          return (
          <article class="project-card" style={`--i: ${idx}`}>
            <div class="project-card__accent" aria-hidden="true"></div>

            <header class="project-card__header">
              <h2 class="project-card__title">{data.title}</h2>
              {data.status && (
                <span class={`project-badge project-badge--${data.status}`}>
                  [{data.status === 'wip' ? 'WIP' :
                     data.status === 'archived' ? 'ARCHIVED' :
                     'ONLINE'}]
                </span>
              )}
            </header>

            <p class="project-card__description">{data.description}</p>

            {(data.problem || data.solution || (data.impact && data.impact.length > 0)) && (
              <details class="project-card__case-study">
                <summary class="project-card__case-study-summary">
                  <span class="project-card__chevron" aria-hidden="true">▸</span>
                  read case study
                </summary>
                <div class="project-card__case-study-body">
                  {data.problem && (
                    <pre class="project-card__case-study-line">// {data.problem}</pre>
                  )}
                  {data.solution && (
                    <pre class="project-card__case-study-line">// {data.solution}</pre>
                  )}
                  {data.impact && data.impact.length > 0 && (
                    <div class="project-card__impact">
                      {data.impact.map((imp: string) => (
                        <div class="project-card__impact-line">
                          <span class="project-card__impact-marker">→</span>
                          <span class="project-card__impact-text">{imp}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              </details>
            )}

            <footer class="project-card__footer">
              {data.tags.length > 0 && (
                <div class="project-card__tags">
                  {data.tags.map((tag: string) => (
                    <span class="project-card__tag">{tag}</span>
                  ))}
                </div>
              )}
              <a
                href={data.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="project-card__repo"
              >
                github ↗
              </a>
            </footer>
          </article>
          )
        })}
      </div>
    )}
  </SectionPanel>
</BaseLayout>

<style>
  /* Task 4.1 — Grid layout */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
    }
    .projects-grid > .project-card:first-child {
      grid-column: 1 / -1;
    }
  }

  /* Task 4.2 — Card initial state (pre-reveal) */
  .project-card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 400ms ease-out,
                transform 400ms ease-out,
                border-color 200ms ease-out,
                box-shadow 200ms ease-out;
  }

  /* Task 4.3 — Reveal transition */
  .project-card.is-visible {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--i, 0) * 80ms);
  }

  /* Task 4.4 — Hover lift */
  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(240, 180, 41, 0.08);
  }

  /* Task 4.5 — Top accent bar */
  .project-card__accent {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 200ms ease-out;
  }

  .project-card:hover .project-card__accent {
    opacity: 1;
  }

  /* Card header */
  .project-card__header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .project-card__title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  /* Card description */
  .project-card__description {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Task 4.6 — Status badge */
  .project-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid currentColor;
    border-radius: 3px;
    white-space: nowrap;
  }

  .project-badge--online,
  .project-badge--wip {
    color: var(--color-accent);
  }

  .project-badge--archived {
    color: var(--color-text-muted);
  }

  /* Case study details */
  .project-card__case-study {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .project-card__case-study-summary {
    cursor: pointer;
    color: var(--color-text-muted);
    user-select: none;
    list-style: none;
  }

  .project-card__case-study-summary::-webkit-details-marker {
    display: none;
  }

  /* Task 4.7 — Chevron rotation */
  .project-card__chevron {
    display: inline-block;
    margin-right: 0.375rem;
    transition: transform 200ms ease-out;
  }

  .project-card__case-study[open] .project-card__chevron {
    transform: rotate(90deg);
  }

  .project-card__case-study-body {
    margin-top: var(--space-2);
    padding-left: var(--space-3);
    border-left: 2px solid var(--color-border);
  }

  .project-card__case-study-line {
    color: var(--color-text-muted);
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* Impact list */
  .project-card__impact {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: var(--space-2);
  }

  .project-card__impact-line {
    display: flex;
    align-items: baseline;
  }

  .project-card__impact-marker {
    color: var(--color-accent);
    margin-right: 0.5rem;
  }

  .project-card__impact-text {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  /* Card footer */
  .project-card__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .project-card__tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    padding: 0.125rem 0.375rem;
  }

  .project-card__repo {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    text-decoration: none;
    transition: color 200ms ease-out;
  }

  .project-card__repo:hover {
    color: var(--color-text);
  }

  /* Task 4.8 — Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card.is-visible {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .project-card__accent,
    .project-card:hover .project-card__accent {
      transition: none;
    }
    .project-card__chevron,
    .project-card__case-study[open] .project-card__chevron {
      transition: none;
    }
  }
</style>
