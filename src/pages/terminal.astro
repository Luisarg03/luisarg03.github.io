---
import '../styles/global.css';
import Shell from '../components/terminal/Shell.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Terminal — Luis Meyehen Paz</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a href="/" class="terminal-back-link">← Back to site</a>
    <Shell />
  </body>
</html>

<script>
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      const input = document.getElementById('terminal-input');
      if (input && document.activeElement === input && (input as HTMLInputElement).value === '') {
        window.location.href = '/';
      }
    }
  });
</script>

<style>
  body {
    margin: 0;
    background: var(--color-bg);
  }

  .terminal-back-link {
    position: fixed;
    top: 0.5rem;
    left: 0.75rem;
    z-index: 100;
    font-family: var(--font-mono, monospace);
    font-size: var(--text-xs, 0.6875rem);
    color: var(--color-text-muted, #6e7681);
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-border, #232d3d);
    border-radius: 4px;
    background: var(--color-surface, #131820);
    transition: color 0.15s, border-color 0.15s;
  }

  .terminal-back-link:hover {
    color: var(--color-accent, #f0b429);
    border-color: var(--color-accent, #f0b429);
  }
</style>
