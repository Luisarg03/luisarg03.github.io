---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import SkillMap from '../components/SkillMap.astro';
import ContactSection from '../components/ContactSection.astro';
import { siteConfig } from '../content/cv';
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.role}`}
  description={siteConfig.summary}
>
  <Hero />

  <div class="section-connector my-8 md:my-12" aria-hidden="true"></div>

  <ExperienceTimeline />

  <div class="section-connector my-8 md:my-12" aria-hidden="true"></div>

  <SkillMap />

  <div class="section-connector my-8 md:my-12" aria-hidden="true"></div>

  <ContactSection />
</BaseLayout>
