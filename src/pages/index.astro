---
import BaseLayout from '../layouts/BaseLayout.astro';
import TermWindow from '../components/terminal/TermWindow.astro';
---

<BaseLayout
  title="Luis Meyehen Paz — Cloud & Data Platform Engineer"
  description="Cloud & data platform engineer, 7+ years on AWS. I build infrastructure and pipelines that help data teams ship faster."
  session="identity"
  footPrompt="$ luis@cloud:~$ ▮"
>
  <main class="screen sess-main">
    <div class="container screen-inner">
      <div class="hero-split">
        <div>
          <p class="eyebrow">~/luisarg · platform engineer</p>
          <h1>I help data teams ship faster.</h1>
          <p class="lead" style="margin-top: 22px;">Cloud &amp; data platform engineer, 7+ years on AWS. I build infrastructure, data pipelines, and self-service tools that make teams faster.</p>
          <div class="hero-cta" style="margin-top: 30px;">
            <a class="btn btn-primary" href="/experience">Experience</a>
            <a class="btn btn-secondary" href="mailto:luis.m.paz.03@gmail.com">Email me</a>
          </div>
          <div style="margin-top: 18px;">
            <a class="cv-dl" href="/cv.pdf" download="LuisPaz-CV.pdf">download LuisPaz-CV.pdf <span class="arr" aria-hidden="true">↓</span></a>
          </div>
        </div>

        <TermWindow title="luis@cloud — neofetch">
          <div class="term-row"><span class="term-key">name</span><span class="term-val term-val--brand">Luis Meyehen Paz</span></div>
          <div class="term-row"><span class="term-key">role</span><span class="term-val">Cloud &amp; Data Platform Engineer</span></div>
          <div class="term-row"><span class="term-key">stack</span><span class="term-val">AWS · Terraform · Python · SQL</span></div>
          <div class="term-row"><span class="term-key">uptime</span><span class="term-val">7+ years in data &amp; cloud</span></div>
          <div class="term-row"><span class="term-key">location</span><span class="term-val">Buenos Aires, Argentina</span></div>
          <div class="term-status">
            <span class="dot" aria-hidden="true"></span>
            <span id="typed-status">open to senior roles · notice: immediate</span><span class="cursor">▮</span>
          </div>
        </TermWindow>
      </div>
    </div>
  </main>
</BaseLayout>

<script>
  (function () {
    var el = document.getElementById('typed-status');
    if (!el || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var text = el.textContent;
    el.textContent = '';
    var i = 0;
    (function tick() {
      if (i <= text.length) {
        el.textContent = text.slice(0, i);
        i += 1;
        setTimeout(tick, 26);
      }
    })();
  })();
</script>
