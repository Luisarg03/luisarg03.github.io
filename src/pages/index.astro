---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import BootModule from '../components/modules/BootModule.astro';
import HostHeader from '../components/modules/HostHeader.astro';
import MotdModule from '../components/modules/MotdModule.astro';
import HtopWindow from '../components/modules/HtopWindow.astro';
import ExperienceModule from '../components/modules/ExperienceModule.astro';
---

<BaseLayout title="Luis Meyehen Paz — Cloud Engineer" showBootChip>
  <!-- BootModule: fixed overlay (out of flow) — HostHeader + HtopWindow
       below are the first actual content in the viewport. -->
  <BootModule />
  <HostHeader />
  <MotdModule />
  <HtopWindow />
  <ExperienceModule />
</BaseLayout>
