---
export interface Props {
  activeWorkspace?: number;
}

const { activeWorkspace = 1 } = Astro.props;

const workspaces = [
  { num: 1, name: 'home' },
  { num: 2, name: 'now' },
  { num: 3, name: 'lab' },
  { num: 4, name: 'contact' },
];
---

<div class="workspace-bar" role="tablist" aria-label="Workspaces">
  {workspaces.map((ws) => (
    <button
      type="button"
      role="tab"
      aria-selected={ws.num === activeWorkspace ? 'true' : 'false'}
      aria-label={`Switch to workspace ${ws.name}`}
      data-workspace={ws.num}
      class:list={[
        'workspace-tag',
        { 'workspace-tag--active': ws.num === activeWorkspace },
      ]}
    >
      <span class="workspace-num">{ws.num}</span>
      <span class="workspace-name">:{ws.name}</span>
    </button>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('.workspace-tag').forEach((btn) => {
    btn.addEventListener('click', () => {
      const ws = parseInt(btn.dataset.workspace || '1');
      window.dispatchEvent(new CustomEvent('workspace-switch', { detail: { workspace: ws } }));
    });
  });
</script>

<style>
  .workspace-bar {
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem 0.5rem;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .workspace-tag {
    display: flex;
    align-items: center;
    gap: 0.125rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    background: transparent;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.15s ease;
    min-height: 32px;
  }

  .workspace-tag:hover {
    background: var(--color-surface-alt);
    color: var(--color-text);
  }

  .workspace-tag--active {
    background: var(--color-accent-glow);
    color: var(--color-text);
    border-color: var(--color-accent);
  }

  .workspace-tag--active .workspace-num {
    color: var(--color-accent);
    font-weight: 600;
  }

  .workspace-num {
    color: inherit;
  }

  .workspace-name {
    color: inherit;
  }

  @media (max-width: 767px) {
    .workspace-tag {
      min-height: 44px;
      min-width: 44px;
      justify-content: center;
      padding: 0.25rem 0.75rem;
    }
  }
</style>
