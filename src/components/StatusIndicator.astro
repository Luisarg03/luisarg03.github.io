---
export interface Props {
  status: 'active' | 'in-progress' | 'planned' | 'offline';
  label?: string;
  class?: string;
}

const statusColors: Record<string, string> = {
  'active': 'var(--color-success)',
  'in-progress': 'var(--color-warning)',
  'planned': 'var(--color-text-muted)',
  'offline': 'var(--color-danger)',
};

const { status, label, class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-1.5', className]}>
  <span
    class:list={[
      'inline-block w-2 h-2 rounded-full relative',
      status === 'active' && 'status-dot status-dot--active',
    ]}
    style={`background-color: ${statusColors[status]}`}
    role="status"
    aria-label={label ?? status}
  ></span>
  {label && <span class="text-xs text-[var(--color-text-muted)] font-mono">{label}</span>}
</span>
