---
/**
 * IdentityModule — the "whoami" section.
 * Decorative terminal framing + real identity content + contact actions.
 */
import { siteConfig, experience } from '../../content/cv';

const yearsExp = new Date().getFullYear() - 2019;
const currentRole = experience.find((e) => e.endDate === null);
---

<section id="identity" class="identity-module" aria-label="Identity">
  <div class="module-divider reveal-on-view" aria-hidden="true">
    <svg viewBox="0 0 1200 2" preserveAspectRatio="none">
      <line x1="0" y1="1" x2="1200" y2="1" />
    </svg>
  </div>

  <div class="module-content identity-content">
    <!-- Decorative prompt -->
    <p class="identity-prompt">$ whoami</p>

    <!-- Merged layout: Arch art + name + details (side by side on desktop, stacked on mobile) -->
    <div class="identity-hero">
      <!-- Decorative Arch ASCII art (left on desktop, top on mobile) -->
      <pre class="identity-art" aria-hidden="true">                    -`
                    .o+`
                   `ooo/
                  `+oooo:
                 `+oooooo:
                 -+oooooo+:
               `/:-:++oooo+:
              `/++++/+++++++:
             `/++++++++++++++:
            `/+++ooooooooooooo/`
           ./ooosssso++osssssso+`
          .oossssso-````/ossssss+`
         -osssssso.      :ssssssso.
        :osssssss/        osssso+++.
       /ossssssss/        +ssssooo/-
     `/ossssso+/:-        -:/+osssso+-
    `+sso+:-`                 `.-/+oso:
   `++:.                           `-/+/`
   .`                                 `/`</pre>

      <!-- Name and details (right on desktop, bottom on mobile) -->
      <div class="identity-info">
        <h1 class="identity-name">{siteConfig.name}</h1>

        <!-- Key details -->
        <div class="identity-details">
          <div class="identity-detail-row">
            <span class="identity-detail-key">Role</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{siteConfig.role}</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Experience</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{yearsExp}+ years</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Current</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{currentRole?.company ?? '—'}</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Location</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{siteConfig.location}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Decorative separator -->
    <p class="identity-prompt">$ cat /etc/motd</p>

    <!-- Summary -->
    <p class="identity-summary">{siteConfig.summary}</p>

    <!-- Contact actions -->
    <p class="identity-prompt">$ ls /contact/</p>

    <div class="identity-contacts">
      <a href={`mailto:${siteConfig.email}`} class="identity-contact-link">
        <span class="identity-contact-file">email.sh</span>
        <span class="identity-contact-label">Email</span>
      </a>
      <a href={siteConfig.github} target="_blank" rel="noopener" class="identity-contact-link">
        <span class="identity-contact-file">github.sh</span>
        <span class="identity-contact-label">GitHub ↗</span>
      </a>
      <a href={siteConfig.linkedin} target="_blank" rel="noopener" class="identity-contact-link">
        <span class="identity-contact-file">linkedin.sh</span>
        <span class="identity-contact-label">LinkedIn ↗</span>
      </a>
      <a href="/cv.pdf" download class="identity-contact-link">
        <span class="identity-contact-file">cv.pdf</span>
        <span class="identity-contact-label">CV ↓</span>
      </a>
    </div>
  </div>
</section>

<style>
  .identity-module {
    padding: var(--space-12) 0 var(--space-8);
  }

  .identity-content {
    max-width: 52rem;
  }

  /* ── Hero container: art + name + details merged (responsive flex) ─────── */
  .identity-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: stretch;
  }

  @media (min-width: 640px) {
    .identity-hero {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      flex-direction: row;
      align-items: start;
      gap: var(--space-4);
    }
  }

  /* ── Arch ASCII art (decorative, copper accent) ────────────────────────── */
  .identity-art {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--color-accent);
    margin: 0;
    user-select: none;
    max-width: 100%;
    overflow-x: auto;
  }

  /* Narrow desktop band (640-719px): shrink art to avoid overflow */
  @media (min-width: 640px) and (max-width: 719px) {
    .identity-art {
      font-size: 10px;
    }
  }

  /* ── Info block: name + details ───────────────────────────────────────── */
  .identity-info {
    min-width: 0;
    max-width: 100%;
  }

  /* ── Decorative prompt lines ─────────────────────────────────────────────── */
  .identity-prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  /* ── Name ────────────────────────────────────────────────────────────── */
  .identity-name {
    font-family: var(--font-mono);
    font-size: var(--text-display-sm);
    font-weight: 700;
    color: var(--color-accent-identity);
    line-height: 1.1;
    margin: 0 0 var(--space-5);
    text-shadow: 0 0 40px var(--color-accent-identity-glow);
  }

  /* Single line only at very wide desktop (>=1200px where there's ample space);
     allow wrapping at medium widths. */
  @media (min-width: 1200px) {
    .identity-name {
      white-space: nowrap;
    }
  }

  /* ── Details ─────────────────────────────────────────────────────────── */
  .identity-details {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .identity-detail-row {
    display: flex;
    align-items: baseline;
  }

  .identity-detail-key {
    color: var(--color-accent-identity);
    font-weight: 600;
    min-width: 7rem;
  }

  .identity-detail-sep {
    color: var(--color-text-muted);
    margin-right: 0.375rem;
  }

  .identity-detail-val {
    color: var(--color-text);
  }

  /* ── Summary ─────────────────────────────────────────────────────────── */
  .identity-summary {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
    max-width: 60ch;
    margin: 0 0 var(--space-6);
  }

  /* ── Contact links ───────────────────────────────────────────────────── */
  .identity-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .identity-contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .identity-contact-link:hover {
    color: var(--color-text);
    border-color: var(--color-border-active);
    background: var(--color-surface-alt);
  }

  .identity-contact-file {
    color: var(--color-accent);
    opacity: 0.7;
  }

  .identity-contact-label {
    color: inherit;
  }
</style>
