---
/**
 * IdentityModule — the "whoami" section.
 * Decorative terminal framing + real identity content + contact actions.
 */
import { siteConfig, experience } from '../../content/cv';
import Card from '../ui/Card.astro';

const yearsExp = new Date().getFullYear() - 2019;
const currentRole = experience.find((e) => e.endDate === null);
---

<section id="identity" class="identity-module" aria-label="Identity">
  <div class="module-divider reveal-on-view" aria-hidden="true">
    <svg viewBox="0 0 1200 2" preserveAspectRatio="none">
      <line x1="0" y1="1" x2="1200" y2="1" />
    </svg>
  </div>

  <div class="module-content identity-content">
    <!-- Decorative prompt lives in the window title bar above -->

    <!-- Merged layout: Arch art + name + details (side by side on desktop, stacked on mobile) -->
    <div class="identity-hero">
      <!-- Decorative Arch ASCII art (left on desktop, top on mobile) -->
      <pre class="identity-art" aria-hidden="true">                    -`
                    .o+`
                   `ooo/
                  `+oooo:
                 `+oooooo:
                 -+oooooo+:
               `/:-:++oooo+:
              `/++++/+++++++:
             `/++++++++++++++:
            `/+++ooooooooooooo/`
           ./ooosssso++osssssso+`
          .oossssso-````/ossssss+`
         -osssssso.      :ssssssso.
        :osssssss/        osssso+++.
       /ossssssss/        +ssssooo/-
     `/ossssso+/:-        -:/+osssso+-
    `+sso+:-`                 `.-/+oso:
   `++:.                           `-/+/`
   .`                                 `/`</pre>

      <!-- Name and details (right on desktop, bottom on mobile) -->
      <div class="identity-info">
        <!-- Key details -->
        <div class="identity-details">
          <h1 class="identity-detail-row">
            <span class="identity-detail-key">Name</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{siteConfig.name}</span>
          </h1>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Role</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{siteConfig.role}</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Experience</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{yearsExp}+ years</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Current</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{currentRole?.company ?? '—'}</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Location</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val">{siteConfig.location}</span>
          </div>
          <div class="identity-separator" aria-hidden="true">// host · ─────────────</div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">OS</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="os">…</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Browser</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="browser">…</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Display</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="display">…</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">DPR</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="dpr">…</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">CPU</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="cpu">…</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Lang</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="lang">…</span>
          </div>
          <div class="identity-detail-row">
            <span class="identity-detail-key">Theme</span>
            <span class="identity-detail-sep">:</span>
            <span class="identity-detail-val" data-host="theme">…</span>
          </div>
        </div>
      </div>

    </div>

    <div class="identity-motd">
      <p class="identity-prompt">$ cat /etc/motd</p>
      <p class="identity-summary">{siteConfig.summary}</p>
    </div>

    <div class="identity-contact">
      <p class="identity-prompt">$ ls /contact/</p>
      <div class="identity-contacts">
        <Card variant="status">
          <a href={`mailto:${siteConfig.email}`} class="identity-contact-link">
            <span class="identity-contact-file">email.sh</span>
            <span class="identity-contact-label">Email</span>
          </a>
        </Card>
        <Card variant="status">
          <a href={siteConfig.github} target="_blank" rel="noopener" class="identity-contact-link">
            <span class="identity-contact-file">github.sh</span>
            <span class="identity-contact-label">GitHub ↗</span>
          </a>
        </Card>
        <Card variant="status">
          <a href={siteConfig.linkedin} target="_blank" rel="noopener" class="identity-contact-link">
            <span class="identity-contact-file">linkedin.sh</span>
            <span class="identity-contact-label">LinkedIn ↗</span>
          </a>
        </Card>
        <Card variant="status">
          <a href="/cv.pdf" download class="identity-contact-link">
            <span class="identity-contact-file">cv.pdf</span>
            <span class="identity-contact-label">CV ↓</span>
          </a>
        </Card>
      </div>
    </div>
  </div>
</section>

<style>
  .identity-module {
    padding: var(--section-gap-lg) 0 var(--section-gap-md);
  }

  .identity-content {
    max-width: 52rem;
  }

  /* ── Hero: art (left) + data (right) 2-col grid on desktop ─────────────── */
  .identity-hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: start;
  }

  @media (min-width: 640px) {
    .identity-hero {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: var(--space-10);
      align-items: start;
      padding: var(--space-5);
      border: 1px solid var(--color-border);
      border-radius: 6px;
      background: var(--color-surface);
      position: relative;
    }

    .identity-hero::before {
      content: '~/luisarg $ whoami --verbose';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      padding: var(--space-2) var(--space-4);
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-muted);
      border-bottom: 1px solid var(--color-border);
      border-radius: 6px 6px 0 0;
      background: var(--color-surface);
      letter-spacing: 0.02em;
    }

    .identity-hero > .identity-art {
      margin-top: var(--space-6);
      padding-right: var(--space-6);
      border-right: 1px solid var(--color-border);
    }

    .identity-hero > .identity-info {
      margin-top: var(--space-6);
    }
  }

  /* ── Arch ASCII art (decorative, copper accent) ────────────────────────── */
  .identity-art {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.3;
    color: var(--color-accent);
    margin: 0;
    user-select: none;
    max-width: 100%;
    overflow-x: auto;
  }

  /* Narrow desktop band (640-719px): shrink art to avoid overflow */
  @media (min-width: 640px) and (max-width: 719px) {
    .identity-art {
      font-size: 10px;
    }
  }

  /* ── Info block: name + details ───────────────────────────────────────── */
  .identity-info {
    min-width: 0;
    max-width: 100%;
  }

  /* ── Decorative prompt lines ─────────────────────────────────────────────── */
  .identity-prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-5);
  }

  /* ── Details ─────────────────────────────────────────────────────────── */
  .identity-details {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    margin-bottom: var(--space-6);
  }

  .identity-detail-row {
    display: flex;
    align-items: baseline;
  }

  .identity-detail-key {
    color: var(--color-accent-identity);
    font-weight: 600;
    min-width: 7rem;
  }

  .identity-detail-sep {
    color: var(--color-text-muted);
    margin-right: 0.375rem;
  }

  .identity-detail-val {
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  /* ── Section separator (personal data ↔ host metadata) ────────────────── */
  .identity-separator {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-identity);
    opacity: 0.7;
    padding: var(--space-3) 0 var(--space-1);
    user-select: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Summary ─────────────────────────────────────────────────────────── */
  .identity-summary {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    line-height: 1.7;
    color: var(--color-text);
    max-width: 60ch;
    margin: 0 0 var(--space-6);
  }

  /* ── Contact links ───────────────────────────────────────────────────── */
  .identity-contacts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .identity-contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease-out, transform 150ms ease-out, box-shadow 150ms ease-out;
  }

  .identity-contact-link:hover {
    color: var(--color-accent);
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(240, 180, 41, 0.15);
  }

  .identity-contact-link:focus-visible {
    color: var(--color-accent);
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .identity-contact-link {
      transition: none;
    }
    .identity-contact-link:hover {
      transform: none;
    }
  }

  .identity-contact-file {
    color: var(--color-accent);
    opacity: 0.8;
  }

  .identity-contact-label {
    color: inherit;
  }

  /* ── MOTD block (3rd block, below hero) ─────────────────────────────────── */
  .identity-motd {
    margin-top: var(--space-10);
    max-width: 60ch;
  }

  /* ── Contact block (4th block, below MOTD) ──────────────────────────────── */
  .identity-contact {
    margin-top: var(--space-8);
  }
</style>

<script>
  // @ts-nocheck
  (function () {
    function detectOS(ua) {
      if (/Windows NT/.test(ua)) return 'Windows';
      if (/Mac OS X|macOS/.test(ua)) return 'macOS';
      if (/Android/.test(ua)) return 'Android';
      if (/iPhone|iPad|iOS/.test(ua)) return 'iOS';
      if (/Linux/.test(ua)) return 'Linux';
      return 'Unknown';
    }

    function detectBrowser(ua) {
      if (/Edg\//.test(ua)) return 'Edge ' + ((ua.match(/Edg\/([\d.]+)/) || [])[1] || '');
      if (/Firefox\//.test(ua)) return 'Firefox ' + ((ua.match(/Firefox\/([\d.]+)/) || [])[1] || '');
      if (/Chrome\//.test(ua) && !/Chromium\//.test(ua)) return 'Chrome ' + ((ua.match(/Chrome\/([\d.]+)/) || [])[1] || '');
      if (/Safari\//.test(ua) && /Version\//.test(ua)) return 'Safari ' + ((ua.match(/Version\/([\d.]+)/) || [])[1] || '');
      return 'Unknown';
    }

    function set(key, val) {
      var el = document.querySelector('[data-host="' + key + '"]');
      if (el) el.textContent = val;
    }

    function init() {
      if (typeof window === 'undefined' || !window.navigator) return;
      var ua = navigator.userAgent || '';
      var dpr = window.devicePixelRatio || 1;
      var w = window.screen && window.screen.width ? window.screen.width : '?';
      var h = window.screen && window.screen.height ? window.screen.height : '?';
      var cores = navigator.hardwareConcurrency || '?';
      var lang = navigator.language || '?';
      var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;

      set('os', detectOS(ua));
      set('browser', detectBrowser(ua));
      set('display', w + 'x' + h + ' @' + dpr + 'x');
      set('dpr', dpr + 'x');
      set('cpu', cores + (cores === 1 ? ' core' : ' cores'));
      set('lang', lang);
      set('theme', dark ? 'dark' : 'light');
    }

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>
