---
/**
 * SkillsModule — the "htop" section.
 * Process-list table with CPU% bars, expandable skill details.
 */
import { skillCategories } from '../../content/cv';

// Map proficiency 0-5 to percentage
function profToPercent(p: number): number {
  return Math.round((p / 5) * 100);
}
---

<section id="skills" class="skills-module" aria-label="Skills">
  <div class="module-divider reveal-on-view" aria-hidden="true">
    <svg viewBox="0 0 1200 2" preserveAspectRatio="none">
      <line x1="0" y1="1" x2="1200" y2="1" />
    </svg>
  </div>

  <div class="module-content skills-content">
    <p class="skills-prompt">$ htop --sort=cpu</p>

    <!-- Table header -->
    <div class="skills-table-header">
      <span class="skills-col-pid">PID</span>
      <span class="skills-col-cpu">CPU%</span>
      <span class="skills-col-mem">MEM%</span>
      <span class="skills-col-cmd">COMMAND</span>
    </div>

    <!-- Skill rows -->
    <div class="skills-table-body">
      {skillCategories.map((cat, i) => {
        const pid = String(i + 1).padStart(3, '0');
        const cpu = profToPercent(cat.proficiency);
        const mem = profToPercent(cat.proficiency) - 5;
        // Collapsed by default on all viewports (D5); expand on click
        const rowId = `skill-row-${i}`;

        return (
          <div class="skills-row-wrap" data-index={i}>
            <button
              class="skills-row skills-row-toggle"
              aria-expanded="false"
              aria-controls={`${rowId}-details`}
              data-row-id={rowId}
            >
              <span class="skills-col-pid">{pid}</span>
              <span class="skills-col-cpu">
                <span class="skills-bar-wrap">
                  <span class="skills-bar" style={`width: ${cpu}%`}></span>
                </span>
                <span class="skills-pct">{cpu}</span>
              </span>
              <span class="skills-col-mem">
                <span class="skills-bar-wrap skills-bar-mem">
                  <span class="skills-bar skills-bar-dim" style={`width: ${mem}%`}></span>
                </span>
                <span class="skills-pct">{mem}</span>
              </span>
              <span class="skills-col-cmd">
                <span class="skills-chevron" aria-hidden="true">▸</span>
                {cat.category}
              </span>
            </button>

            <div
              id={`${rowId}-details`}
              class="skills-details"
              role="region"
              aria-labelledby={rowId}
              hidden
            >
              <div class="skills-detail-inner">
                {cat.skills.map((skill) => (
                  <span class="skills-detail-item">{skill}</span>
                ))}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  (function () {
    // Rows render collapsed server-side on all viewports (D5). Single
    // document-level listener (delegation): survives the full DOM swaps of
    // Astro view transitions, which drop per-button listeners after nav.
    document.addEventListener('click', function (event) {
      var btn = event.target.closest ? event.target.closest('.skills-row-toggle') : null;
      if (!btn) return;

      var expanded = btn.getAttribute('aria-expanded') === 'true';
      var id = btn.getAttribute('aria-controls');
      var panel = id ? document.getElementById(id) : null;
      if (!panel) return;

      btn.setAttribute('aria-expanded', String(!expanded));
      panel.hidden = expanded;

      // Rotate chevron
      var chevron = btn.querySelector('.skills-chevron');
      if (chevron) {
        chevron.style.transform = expanded ? '' : 'rotate(90deg)';
      }
    });
  })();
</script>

<style>
  .skills-module {
    padding: var(--space-8) 0;
  }

  .skills-content {
    max-width: 64rem;
  }

  .skills-prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
    opacity: 0.6;
  }

  /* ── Table header ────────────────────────────────────────────────────── */
  .skills-table-header {
    display: grid;
    grid-template-columns: 3.5rem 1fr 1fr 1fr;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-bottom: 1px solid var(--color-border);
    opacity: 0.6;
  }

  /* ── Table rows ──────────────────────────────────────────────────────── */
  .skills-table-body {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .skills-row-wrap {
    border-bottom: 1px solid var(--color-border);
  }

  .skills-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 1fr 1fr;
    gap: var(--space-2);
    align-items: center;
    width: 100%;
    padding: var(--space-3);
    background: transparent;
    border: none;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: background 0.15s;
    text-align: left;
  }

  .skills-row:hover {
    background: var(--color-surface-alt);
  }

  .skills-row:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .skills-col-pid {
    color: var(--color-text-muted);
  }

  .skills-col-cpu,
  .skills-col-mem {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .skills-col-cmd {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 500;
  }

  .skills-chevron {
    /* 0.875rem — big enough to read as an expand affordance on mobile
       collapsed rows (was 0.625rem, easy to miss at 390px) */
    font-size: 0.875rem;
    color: var(--color-accent);
    transition: transform 0.2s ease;
    flex-shrink: 0;
  }

  /* ── Bar visualization ───────────────────────────────────────────────── */
  .skills-bar-wrap {
    flex: 1;
    height: 4px;
    background: var(--color-border);
    border-radius: 2px;
    overflow: hidden;
    min-width: 3rem;
  }

  .skills-bar {
    display: block;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--color-accent-dim), var(--color-accent));
    position: relative;
    transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .skills-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.15) 50%, transparent 100%);
    animation: bar-shimmer 2.5s ease-in-out infinite;
  }

  .skills-bar-dim::after {
    animation: none;
  }

  @keyframes bar-shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .skills-bar::after {
      animation: none;
    }
  }

  .skills-pct {
    min-width: 2rem;
    text-align: right;
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  /* ── Expanded details ────────────────────────────────────────────────── */
  .skills-details {
    padding: 0 var(--space-3) var(--space-3);
  }

  .skills-detail-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    padding-left: 7.5rem;
  }

  .skills-detail-item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding: 0.125rem 0;
  }

  .skills-detail-item::before {
    content: '·';
    color: var(--color-accent);
    margin-right: 0.375rem;
  }

  /* ── Mobile adjustments ──────────────────────────────────────────────── */
  @media (max-width: 639px) {
    .skills-table-header {
      display: none;
    }

    .skills-row {
      grid-template-columns: 2.5rem 1fr auto;
      grid-template-rows: auto auto;
      gap: 0;
      padding: var(--space-3);
    }

    .skills-col-pid {
      grid-column: 1;
      grid-row: 1;
      font-size: var(--text-xs);
    }

    .skills-col-cmd {
      grid-column: 2;
      grid-row: 1;
    }

    .skills-col-cpu {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-top: var(--space-2);
    }

    .skills-col-mem {
      display: none;
    }

    .skills-detail-inner {
      padding-left: 0;
    }
  }
</style>
