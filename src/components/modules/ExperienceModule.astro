---
/**
 * ExperienceModule — the "journalctl" section.
 * Timestamped log lines, progressive disclosure for older roles.
 */
import { experience } from '../../content/cv';

// Parse MM/YYYY to { month, year }
function parseDate(d: string) {
  const [month, year] = d.split('/');
  const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  return { month: months[parseInt(month, 10) - 1], year };
}

// Group by year, sorted desc
const sorted = [...experience].sort((a, b) => {
  const ya = parseInt(a.startDate.split('/')[1], 10);
  const yb = parseInt(b.startDate.split('/')[1], 10);
  return yb - ya;
});

const yearGroups: Record<string, typeof experience> = {};
sorted.forEach((exp) => {
  const year = exp.startDate.split('/')[1];
  if (!yearGroups[year]) yearGroups[year] = [];
  yearGroups[year].push(exp);
});

const years = Object.keys(yearGroups).sort((a, b) => parseInt(b) - parseInt(a));

// How many recent roles to show expanded (by index in sorted list)
const EXPANDED_COUNT = 3;
---

<section id="experience" class="experience-module" aria-label="Experience">
  <div class="module-divider reveal-on-view" aria-hidden="true">
    <svg viewBox="0 0 1200 2" preserveAspectRatio="none">
      <line x1="0" y1="1" x2="1200" y2="1" />
    </svg>
  </div>

  <div class="module-content experience-content">
    <p class="experience-prompt">$ journalctl -u career --since 2019</p>

    <div class="experience-log">
      {years.map((year, yi) => {
        const roles = yearGroups[year];
        let globalIdx = 0;
        for (let y = 0; y < yi; y++) {
          globalIdx += yearGroups[years[y]].length;
        }

        return (
          <div class="experience-year-group">
            <div class="experience-year-sep" aria-hidden="true">
              ─── {year} ───
            </div>

            {roles.map((exp, ri) => {
              const start = parseDate(exp.startDate);
              const isActive = exp.endDate === null;
              const showExpanded = (globalIdx + ri) < EXPANDED_COUNT;
              const detailId = `exp-detail-${year}-${ri}`;
              const hasResponsibilities = exp.responsibilities.length > 0;

              return (
                <div class="experience-entry">
                  <div class="experience-entry-header">
                    {isActive && (
                      <span class="experience-active-badge">
                        <span class="status-dot status-dot--active" aria-hidden="true"></span>
                        ACTIVE
                      </span>
                    )}
                    <span class="experience-date">
                      {start.month} {start.year}
                    </span>
                    <span class="experience-sep">[started]</span>
                    <span class="experience-role">{exp.role}</span>
                    <span class="experience-company">{exp.company}</span>
                  </div>

                  {hasResponsibilities && (
                    <>
                      <div
                        id={detailId}
                        class="experience-details"
                        role="region"
                        aria-label={`${exp.role} at ${exp.company} details`}
                        hidden={!showExpanded}
                      >
                        <div class="experience-detail-inner">
                          {exp.responsibilities.map((r) => (
                            <div class="experience-resp">· {r}</div>
                          ))}
                        </div>
                      </div>

                      {!showExpanded && (
                        <button
                          class="experience-toggle"
                          aria-expanded="false"
                          aria-controls={detailId}
                        >
                          <span class="experience-toggle-label">Show details</span>
                        </button>
                      )}
                    </>
                  )}
                </div>
              );
            })}
          </div>
        );
      })}
    </div>

    <p class="experience-prompt experience-uptime">$ uptime</p>
    <p class="experience-uptime-val">
      07:03:14 up {new Date().getFullYear() - 2019} years, {new Date().getMonth()} months
    </p>
  </div>
</section>

<script>
  // @ts-nocheck
  (function () {
    document.querySelectorAll('.experience-toggle').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var expanded = this.getAttribute('aria-expanded') === 'true';
        var id = this.getAttribute('aria-controls');
        var panel = id ? document.getElementById(id) : null;
        if (!panel) return;

        this.setAttribute('aria-expanded', String(!expanded));
        panel.hidden = expanded;

        var label = this.querySelector('.experience-toggle-label');
        if (label) {
          label.textContent = expanded ? 'Show details' : 'Hide details';
        }
      });
    });
  })();
</script>

<style>
  .experience-module {
    padding: var(--space-8) 0;
  }

  .experience-content {
    max-width: 52rem;
  }

  .experience-prompt {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
    opacity: 0.6;
  }

  /* ── Year separator ──────────────────────────────────────────────────── */
  .experience-year-sep {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-4) 0 var(--space-2);
    opacity: 0.4;
    letter-spacing: 0.15em;
  }

  /* ── Log entry ───────────────────────────────────────────────────────── */
  .experience-entry {
    padding: var(--space-3) var(--space-4);
    border-left: 2px solid var(--color-border);
    margin-left: var(--space-2);
    transition: border-color 0.15s;
  }

  .experience-entry:hover {
    border-left-color: var(--color-accent);
  }

  .experience-entry-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .experience-active-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-success);
    border: 1px solid var(--color-success);
    border-radius: 3px;
    letter-spacing: 0.08em;
  }

  .experience-date {
    color: var(--color-text-muted);
    min-width: 5rem;
  }

  .experience-sep {
    color: var(--color-text-muted);
    opacity: 0.4;
    font-size: var(--text-xs);
  }

  .experience-role {
    color: var(--color-text);
    font-weight: 500;
  }

  .experience-company {
    color: var(--color-accent);
  }

  /* ── Details ─────────────────────────────────────────────────────────── */
  .experience-details {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
  }

  .experience-detail-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .experience-resp {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* ── Toggle button ───────────────────────────────────────────────────── */
  .experience-toggle {
    background: none;
    border: none;
    padding: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    cursor: pointer;
    opacity: 0.7;
    transition: opacity 0.15s;
  }

  .experience-toggle:hover {
    opacity: 1;
  }

  .experience-toggle:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Uptime ──────────────────────────────────────────────────────────── */
  .experience-uptime-val {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text);
    margin: 0;
    padding-left: var(--space-4);
  }
</style>
