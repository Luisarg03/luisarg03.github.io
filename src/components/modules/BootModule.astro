---
/**
 * BootModule — transient full-viewport boot overlay for the homepage.
 * Plays on first page entry (full load of `/`), then fades out and is
 * removed from the DOM. Decorative only; the page content sits behind it
 * from the start (zero layout shift — `position: fixed` takes no space).
 * Skipped entirely on: quick mode (sessionStorage), reduced motion, no-JS,
 * client-side navigation, `back_forward` loads, and direct hash loads.
 */
import { LUIS_BOOT_FRAMES } from '../../scripts/boot-frames.js';
---

<div class="boot-overlay" id="boot-overlay" hidden aria-hidden="true">
  <div class="boot-content">
    <!-- OS brand prelude — fixed string, rendered synchronously (CLS anchor) -->
    <pre class="boot-prelude">-`
                  .o+`
                 `ooo/
                `+oooo:
               `+oooooo:
               -+oooooo+:
             `/:-:++oooo+:
            `/++++/+++++++:
           `/++++++++++++++:
          `/+++ooooooooooooo/`
         ./ooosssso++osssssso+`
        .oossssso-````/ossssss+`
       -osssssso.      :ssssssso.
      :osssssss/        osssso+++.
     /ossssssss/        +ssssooo/-
   `/ossssso+/:-        -:/+osssso+-
  `+sso+:-`                 `.-/+oso:
 `++:.                           `-/+/
 .`                                 `/</pre>

    <div class="boot-terminal" id="boot-terminal">
      <!-- Static fallback — never displayed (overlay is hidden without JS).
           Maps canonical frames so a failed engine still has content. -->
      {LUIS_BOOT_FRAMES.map((frame) => (
        <div class="boot-line" set:html={frame} />
      ))}
    </div>
  </div>
</div>

<script>
  // @ts-nocheck
  import '../../scripts/boot';

  (function () {
    const overlay = document.getElementById('boot-overlay');
    const terminal = document.getElementById('boot-terminal');
    if (!overlay || !terminal) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let quickMode = false;
    try {
      quickMode = sessionStorage.getItem('luisos-booted') === '1';
    } catch (e) { /* ignore storage errors */ }

    // Full page loads only. navigation.type is 'back_forward' on real
    // document back/forward loads. history.state.index > 0 means the page
    // was reached via an Astro view transition (ClientRouter bumps the index
    // on every pushState, and patches the initial state to index 0).
    const navType = performance.getEntriesByType('navigation')[0]?.type ?? 'navigate';
    const viaClientNav = !!(history.state && history.state.index > 0);

    const shouldPlay =
      !prefersReducedMotion &&
      !quickMode &&
      navType !== 'back_forward' &&
      !viaClientNav &&
      !location.hash &&
      typeof window.initBootSequence === 'function';

    if (!shouldPlay) return;

    let fading = false;
    let controller = null;

    function unlockScroll() {
      document.documentElement.style.overflow = '';
    }

    function fadeAndRemove() {
      if (fading) return;
      fading = true;
      unlockScroll();
      overlay.classList.add('boot-overlay-fade');
      // Fade (≤ 0.5s), then drop the overlay and trigger htop bar cascade.
      setTimeout(function () {
        overlay.remove();
        window.removeEventListener('wheel', skip);
        window.removeEventListener('scroll', skip);
        // Signal htop window to start bar fill cascade
        document.dispatchEvent(new CustomEvent('boot-overlay-hidden'));
      }, 500);
    }

    function skip() {
      if (controller && controller.skip) controller.skip();
    }

    // Skip on scroll attempts too — the engine already handles
    // click/keydown/touchstart. Scroll-as-skip also releases the scroll lock.
    window.addEventListener('wheel', skip, { once: true, passive: true });
    window.addEventListener('scroll', skip, { once: true, passive: true });

    // Reveal + scroll lock. Clear the static fallback FIRST so the typing
    // engine starts from an empty terminal with no flash of static lines.
    terminal.innerHTML = '';
    document.documentElement.style.overflow = 'hidden';
    overlay.hidden = false;

    // Start the engine after the reveal: it renders the first frame
    // synchronously, so line 1 is never lost to the clear above.
    controller = window.initBootSequence(terminal, {
      frameDelay: 250,
      onComplete: fadeAndRemove,
    });

    // Fallback guarantee: even if the typing engine stalls, the overlay
    // always fades out and unlocks (2.5s typing budget + 0.5s fade + margin).
    setTimeout(fadeAndRemove, 4000);
  })();
</script>

<style>
  /* ── Overlay ─────────────────────────────────────────────────────────── */
  .boot-overlay {
    /* Above the header (z-10) and module content; below the command
       palette (z-9999). */
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-6);
    background: var(--color-bg);
    opacity: 1;
    transition: opacity 0.5s ease;
  }

  /* The UA [hidden] display:none is overridden by display:flex above —
     restore the hidden state explicitly (no-JS and all skip paths rely on
     the overlay never rendering). */
  .boot-overlay[hidden] {
    display: none;
  }

  .boot-overlay.boot-overlay-fade {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Content wrapper (neofetch layout) ──────────────────────────────── */
  .boot-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  @media (min-width: 640px) {
    .boot-content {
      flex-direction: row;
      align-items: flex-start;
      gap: 3ch;
    }
  }

  /* ── OS prelude (pre-line) ──────────────────────────────────────────── */
  .boot-prelude {
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 14px;
    line-height: 1.1;
    color: var(--color-accent);
    margin: 0;
    white-space: pre;
    position: relative;
    z-index: 2;  /* above the scan lines */
    animation: boot-prelude-glitch 0.5s ease-out 1 both;
  }

  @keyframes boot-prelude-glitch {
    0%   { text-shadow:  2px 0 var(--color-accent-identity), -2px 0 var(--color-accent); }
    20%  { text-shadow: -2px 1px var(--color-accent-identity),  2px -1px var(--color-accent); }
    40%  { text-shadow:  1px -1px var(--color-accent-identity), -1px 1px var(--color-accent); }
    60%  { text-shadow:  0 0 transparent, 0 0 transparent; }
    100% { text-shadow: none; }
  }

  /* CRT scan lines over the whole overlay (below the text, above the bg) */
  .boot-overlay::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 2px,
      rgba(255, 255, 255, 0.025) 2px,
      rgba(255, 255, 255, 0.025) 3px
    );
    z-index: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-overlay {
      transition: none;
    }
  }

  .boot-terminal {
    flex: 1;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.8;
    color: var(--color-text-muted);
    white-space: pre-wrap;
    word-break: break-word;
  }

  .boot-line {
    animation: boot-line-in 0.15s ease-out both;
  }

  @keyframes boot-line-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  :global(.boot-ok) {
    color: var(--color-accent);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-line {
      animation: none;
    }

    .boot-prelude {
      animation: none;
    }
  }

  /* ── Responsive — mobile 390px ─────────────────────────────────────── */
  @media (max-width: 639px) {
    .boot-prelude {
      font-size: 10px;
      margin-bottom: var(--space-4);
    }

    .boot-terminal {
      font-size: var(--text-xs);
      line-height: 1.6;
    }
  }
</style>
