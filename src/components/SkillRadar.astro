---
import type { SkillCategory } from '../content/cv';

export interface Props {
  categories: SkillCategory[];
}

const { categories } = Astro.props;

const centerX = 120;
const centerY = 120;
const maxR = 80;
const minR = maxR * 0.3;
const scaleR = maxR * 0.95 - minR;

const numCats = categories.length;
const gridLevels = [0, 1, 2, 3, 4, 5];

function angle(i: number): number {
  return (i / numCats) * 2 * Math.PI - Math.PI / 2;
}

function pt(angleRad: number, radius: number) {
  return {
    x: centerX + radius * Math.cos(angleRad),
    y: centerY + radius * Math.sin(angleRad),
  };
}

const gridRadii = gridLevels.map((l) => minR + (l / 5) * scaleR);

const axes = categories.map((_, i) => pt(angle(i), maxR));

const polyPts = categories.map((cat, i) => {
  const prof = Math.max(0, Math.min(5, cat.proficiency ?? 0));
  const r = minR + (prof / 5) * scaleR;
  return pt(angle(i), r);
});
const polyStr = polyPts.map((p) => `${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
---

<svg
  viewBox="0 0 240 240"
  class="w-full h-auto radar-svg"
  role="img"
  aria-label={`Skill proficiency radar chart with ${numCats} categories`}
>
  <!-- Grid rings -->
  {gridRadii.map((r) => (
    <circle
      cx={centerX}
      cy={centerY}
      r={r}
      fill="none"
      stroke="var(--color-border)"
      stroke-width="0.5"
      opacity="0.25"
    />
  ))}

  <!-- Axis lines -->
  {axes.map((p) => (
    <line
      x1={centerX}
      y1={centerY}
      x2={p.x}
      y2={p.y}
      stroke="var(--color-border)"
      stroke-width="0.5"
      opacity="0.4"
    />
  ))}

  <!-- Proficiency polygon -->
  <polygon
    points={polyStr}
    fill="var(--color-accent-warm)"
    fill-opacity="0.1"
    stroke="var(--color-accent-warm)"
    stroke-opacity="0.4"
    stroke-width="2"
    stroke-linejoin="round"
    class="radar-polygon"
  />

  <!-- Interactive axis groups -->
  {categories.map((cat, i) => {
    const a = angle(i);
    const labelR = maxR + 16;
    const labelP = pt(a, labelR);
    const isLeft = labelP.x < centerX - 8;
    const isRight = labelP.x > centerX + 8;
    const textAnchor = isLeft ? 'end' : isRight ? 'start' : 'middle';
    const axisP = axes[i];
    const prof = cat.proficiency ?? 0;
    return (
      <g
        tabindex="0"
        role="img"
        aria-label={`${cat.category}: ${prof} out of 5`}
        class="radar-axis"
        data-category={cat.category}
        data-proficiency={prof}
        onmouseenter={`this.dispatchEvent(new CustomEvent('skill-category-focus', { bubbles: true, detail: { category: '${cat.category}' } }))`}
        onmouseleave={`this.dispatchEvent(new CustomEvent('skill-category-focus', { bubbles: true, detail: { category: null } }))`}
        onfocus={`this.dispatchEvent(new CustomEvent('skill-category-focus', { bubbles: true, detail: { category: '${cat.category}' } }))`}
        onblur={`this.dispatchEvent(new CustomEvent('skill-category-focus', { bubbles: true, detail: { category: null } }))`}
        onkeydown={`if (event.key==='Enter'||event.key===' '){event.preventDefault();this.dispatchEvent(new CustomEvent('skill-category-focus',{bubbles:true,detail:{category:'${cat.category}'}}))}`}
      >
        <title>{cat.category}: {prof}/5</title>

        <!-- Hit area (invisible) -->
        <line
          x1={centerX}
          y1={centerY}
          x2={axisP.x}
          y2={axisP.y}
          stroke="transparent"
          stroke-width="16"
          class="radar-axis-hit"
        />

        <!-- Endpoint dot -->
        <circle
          cx={axisP.x}
          cy={axisP.y}
          r="3"
          fill="var(--color-accent-warm)"
          opacity="0.6"
        />

        <!-- Label -->
        <text
          x={labelP.x}
          y={labelP.y}
          fill="var(--color-text-muted)"
          font-family="var(--font-mono)"
          font-size="8"
          text-anchor={textAnchor}
          dominant-baseline="middle"
        >
          {cat.category}
        </text>
      </g>
    );
  })}
</svg>

<style>
  .radar-axis {
    cursor: pointer;
    outline: none;
    transition: opacity 0.2s ease;
  }
  .radar-axis:focus-visible {
    outline: 1px solid var(--color-accent-warm);
    outline-offset: 2px;
    border-radius: 2px;
  }
  .radar-axis:hover .radar-axis-hit,
  .radar-axis:focus-visible .radar-axis-hit {
    stroke: var(--color-accent-warm);
    stroke-opacity: 0.15;
  }
</style>
