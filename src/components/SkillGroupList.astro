---
import type { SkillCategory } from '../content/cv';

export interface Props {
  categories: SkillCategory[];
  categoryAccents: Record<string, string>;
}

const { categories, categoryAccents } = Astro.props;
---

<div class="skill-group-list" data-active-category="" aria-live="polite" aria-relevant="text" aria-label="Skill categories">
  <span class="sr-only" aria-hidden="true"></span>
  {categories.map((cat) => {
    const accent = categoryAccents[cat.category] || 'var(--color-accent)';
    return (
      <details class="skill-group" data-category={cat.category}>
        <summary class="skill-group-header">
          <span
            class="skill-dot"
            style={`background-color: ${accent}; box-shadow: 0 0 6px ${accent}40`}
            aria-hidden="true"
          >
          </span>
          <span class="skill-group-name">{cat.category}</span>
          <span class="skill-group-count">{cat.skills.length}</span>
          <svg class="skill-chevron" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
            <path d="M3 5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <div class="skill-group-tags">
          <ul class="skill-tag-list">
            {cat.skills.map((skill) => (
              <li>
                <span
                  class="skill-tag"
                  style={`border-color: color-mix(in srgb, ${accent} 18%, var(--color-border))`}
                >
                  {skill}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </details>
    );
  })}
</div>

<script>
  (function () {
    const root = document.querySelector('.skill-group-list');
    if (!root) return;

    const groups = root.querySelectorAll('.skill-group');

    // Desktop: expand all groups on load
    function updateExpansion() {
      const isMobile = window.innerWidth < 640;
      groups.forEach((g) => {
        if (!isMobile) {
          g.setAttribute('open', '');
          g.classList.add('expanded');
        } else {
          g.removeAttribute('open');
          g.classList.remove('expanded');
        }
      });
    }

    updateExpansion();
    window.addEventListener('resize', updateExpansion);

    // Handle header click on mobile — toggle group
    root.addEventListener('click', function (e) {
      var target = e.target;
      if (!target) return;
      var summary = target.closest('.skill-group-header');
      if (!summary) return;
      var group = summary.closest('.skill-group');
      if (!group) return;
      var isOpen = group.hasAttribute('open');
      if (isOpen) {
        group.removeAttribute('open');
        group.classList.remove('expanded');
      } else {
        group.setAttribute('open', '');
        group.classList.add('expanded');
      }
    });

    // Listen for skill-category-focus event
    root.addEventListener('skill-category-focus', function (e) {
      var category = e.detail ? e.detail.category : null;
      if (category) {
        root.setAttribute('data-active-category', category);
        // Set active/dimmed on groups for CSS highlighting
        var all = root.querySelectorAll('.skill-group');
        for (var i = 0; i < all.length; i++) {
          if (all[i].getAttribute('data-category') === category) {
            all[i].setAttribute('data-active', 'true');
            all[i].removeAttribute('data-dimmed');
          } else {
            all[i].removeAttribute('data-active');
            all[i].setAttribute('data-dimmed', '');
          }
        }
        // Update screen reader announcement
        var sr = root.querySelector('.sr-only');
        if (sr) sr.textContent = 'Active category: ' + category;
      } else {
        root.removeAttribute('data-active-category');
        // Clear all active/dimmed states
        var all = root.querySelectorAll('.skill-group');
        for (var i = 0; i < all.length; i++) {
          all[i].removeAttribute('data-active');
          all[i].removeAttribute('data-dimmed');
        }
      }
    });
  })();
</script>

<style>
  .skill-group-list {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .skill-group {
    border: 1px solid var(--color-border);
    border-radius: var(--panel-radius);
    background: var(--color-surface);
    transition: border-color 0.3s ease, opacity 0.3s ease, box-shadow 0.3s ease;
  }

  .skill-group[open] {
    border-color: var(--color-border-active);
  }

  /* Active state — dimmed groups */
  .skill-group[data-dimmed] {
    opacity: 0.35;
    transition: opacity 0.25s ease;
  }
  /* Active state — highlighted group */
  .skill-group[data-active] {
    opacity: 1;
    border-color: var(--color-border-active);
    box-shadow: 0 0 12px rgba(88, 166, 255, 0.06);
  }

  .skill-group-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 0.75rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }
  .skill-group-header::-webkit-details-marker {
    display: none;
  }
  .skill-group-header::marker {
    display: none;
    content: '';
  }

  .skill-dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    flex-shrink: 0;
    display: block;
  }

  .skill-group-name {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    flex: 1;
  }

  .skill-group-count {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-text-muted);
    opacity: 0.5;
  }

  .skill-chevron {
    color: var(--color-text-muted);
    opacity: 0.4;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    flex-shrink: 0;
  }

  .expanded .skill-chevron,
  .skill-group[open] .skill-chevron {
    transform: rotate(180deg);
  }

  .skill-group-tags {
    padding: 0 0.75rem 0.75rem;
  }

  .skill-tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .skill-tag {
    display: inline-block;
    padding: 0.125rem 0.5rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--color-text);
    background: var(--color-surface-alt);
    border: 1px solid var(--color-border);
    border-radius: 3px;
    transition: border-color 0.2s ease;
    cursor: default;
  }

  .skill-tag:hover {
    border-color: var(--color-border-active);
  }

  /* Desktop: show all groups expanded */
  @media (min-width: 640px) {
    .skill-group {
      border: none;
      border-radius: 0;
      background: transparent;
      padding: 0;
    }
    .skill-group-header {
      padding: 0.375rem 0;
    }
    .skill-group-tags {
      padding: 0.375rem 0 0.5rem 1rem;
    }
    .skill-group-list {
      gap: 0;
    }
    .skill-chevron {
      display: none;
    }
  }

  /* Screen reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
