---
// Blueprint grid background — procedural canvas island.
// Enhanced: varied grid densities, color zones, infrastructure diagram feel.
// Honours prefers-reduced-motion: falls back to a single static frame.
// Directional light: radial-gradient overlay with top-left copper source.
---

<div class="blueprint-grid-wrapper parallax-layer" style="content-visibility: auto; contain: paint;" aria-hidden="true">
  <canvas
    id="blueprint-grid"
    class="fixed inset-0 w-full h-full pointer-events-none z-0"
    style="will-change: transform;"
    aria-hidden="true"
  ></canvas>
  <div class="blueprint-grid-light-overlay" aria-hidden="true"></div>
</div>

<style>
  .blueprint-grid-wrapper {
    position: relative;
  }

  .blueprint-grid-light-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(
      ellipse at 15% 15%,
      rgba(240, 180, 41, 0.03) 0%,
      rgba(240, 180, 41, 0.01) 30%,
      transparent 70%
    );
    mix-blend-mode: screen;
  }

  @media (prefers-reduced-motion: reduce) {
    .blueprint-grid-light-overlay {
      opacity: 0.5;
    }
  }
</style>

<script>
  const canvas = document.getElementById('blueprint-grid') as HTMLCanvasElement | null;
  if (!canvas) throw new Error('blueprint-grid canvas not found');
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('2d context unavailable');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Configuration
  const GRID_MAJOR = 80;
  const GRID_MINOR = 20;
  const DPR_CAP = 2;
  const PULSE_SPEED = 0.0008;
  const NODE_COUNT = 15;
  const TRACE_MAX = 200;

  type Node = { x: number; y: number; vx: number; vy: number; size: number; hue: number };
  let nodes: Node[] = [];
  let width = 0;
  let height = 0;
  let dpr = 1;
  let lastTime = 0;

  // Cursor gravity state
  let cursorX: number | null = null;
  let cursorY: number | null = null;
  let cursorInfluence = 0;
  let lastCursorTime = 0;
  const isTouchDevice = window.matchMedia('(pointer: coarse)').matches;
  const gravityEnabled = !reduceMotion && !isTouchDevice;

  function seedNodes() {
    nodes = Array.from({ length: NODE_COUNT }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.12,
      vy: (Math.random() - 0.5) * 0.12,
      size: 1 + Math.random() * 2,
      hue: Math.random() > 0.8 ? 140 : 210, // mostly blue, some green
    }));
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas!.width = Math.floor(width * dpr);
    canvas!.height = Math.floor(height * dpr);
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    seedNodes();
    if (reduceMotion) render(0);
  }

  function drawGrid() {
    // Minor grid — very subtle
    const minor = 'rgba(100, 130, 170, 0.04)';
    ctx!.strokeStyle = minor;
    ctx!.lineWidth = 0.5;
    ctx!.beginPath();
    for (let x = 0; x < width; x += GRID_MINOR) {
      ctx!.moveTo(x, 0);
      ctx!.lineTo(x, height);
    }
    for (let y = 0; y < height; y += GRID_MINOR) {
      ctx!.moveTo(0, y);
      ctx!.lineTo(width, y);
    }
    ctx!.stroke();

    // Major grid — slightly more visible
    const major = 'rgba(100, 130, 170, 0.08)';
    ctx!.strokeStyle = major;
    ctx!.lineWidth = 0.5;
    ctx!.beginPath();
    for (let x = 0; x < width; x += GRID_MAJOR) {
      ctx!.moveTo(x, 0);
      ctx!.lineTo(x, height);
    }
    for (let y = 0; y < height; y += GRID_MAJOR) {
      ctx!.moveTo(0, y);
      ctx!.lineTo(width, y);
    }
    ctx!.stroke();

    // Accent cross-hairs at major intersections (sparse)
    ctx!.strokeStyle = 'rgba(88, 166, 255, 0.06)';
    ctx!.lineWidth = 1;
    const STEP = GRID_MAJOR * 4;
    for (let x = 0; x < width; x += STEP) {
      for (let y = 0; y < height; y += STEP) {
        ctx!.beginPath();
        ctx!.moveTo(x - 4, y);
        ctx!.lineTo(x + 4, y);
        ctx!.moveTo(x, y - 4);
        ctx!.lineTo(x, y + 4);
        ctx!.stroke();
      }
    }
  }

  function drawNodes(t: number) {
    // Decay cursor influence when mouse stops
    if (gravityEnabled && cursorInfluence > 0) {
      const now = performance.now();
      if (now - lastCursorTime > 120) {
        cursorInfluence *= 0.92;
        if (cursorInfluence < 0.005) {
          cursorInfluence = 0;
          cursorX = null;
          cursorY = null;
        }
      }
    }

    for (const n of nodes) {
      // Cursor gravity: gentle attraction toward mouse within 200px
      if (gravityEnabled && cursorX !== null && cursorY !== null && cursorInfluence > 0) {
        const dx = cursorX - n.x;
        const dy = cursorY - n.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 200 && dist > 0.5) {
          // Max force 0.2 at distance 0, decreases linearly to 0 at 200px
          const force = (1 - dist / 200) * 0.2 * cursorInfluence;
          n.vx += (dx / dist) * force;
          n.vy += (dy / dist) * force;
        }
      }

      n.x += n.vx;
      n.y += n.vy;
      if (n.x < 0 || n.x > width) n.vx *= -1;
      if (n.y < 0 || n.y > height) n.vy *= -1;

      const phase = (t * PULSE_SPEED + (n.x + n.y) * 0.01) % 1;
      const radius = n.size + phase * 2;
      const alpha = 0.2 + phase * 0.5;

      // Glow
      const gradient = ctx!.createRadialGradient(n.x, n.y, 0, n.x, n.y, radius * 3);
      gradient.addColorStop(0, `hsla(${n.hue}, 70%, 60%, ${alpha * 0.3})`);
      gradient.addColorStop(1, `hsla(${n.hue}, 70%, 60%, 0)`);
      ctx!.fillStyle = gradient;
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, radius * 3, 0, Math.PI * 2);
      ctx!.fill();

      // Core
      ctx!.beginPath();
      ctx!.arc(n.x, n.y, radius, 0, Math.PI * 2);
      ctx!.fillStyle = `hsla(${n.hue}, 70%, 65%, ${alpha})`;
      ctx!.fill();
    }
  }

  function drawTraces() {
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist > TRACE_MAX) continue;
        const alpha = (1 - dist / TRACE_MAX) * 0.12;
        ctx!.strokeStyle = `rgba(88, 166, 255, ${alpha})`;
        ctx!.lineWidth = 0.5;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
      }
    }
  }

  // Subtle radial vignette
  function drawVignette() {
    const gradient = ctx!.createRadialGradient(
      width / 2, height / 2, Math.min(width, height) * 0.2,
      width / 2, height / 2, Math.max(width, height) * 0.8
    );
    gradient.addColorStop(0, 'rgba(10, 14, 20, 0)');
    gradient.addColorStop(1, 'rgba(10, 14, 20, 0.4)');
    ctx!.fillStyle = gradient;
    ctx!.fillRect(0, 0, width, height);
  }

  function render(t: number) {
    ctx!.clearRect(0, 0, width, height);
    drawGrid();
    drawTraces();
    drawNodes(t);
    drawVignette();
  }

  function loop(t: number) {
    if (reduceMotion) return;
    if (t - lastTime > 16) {
      render(t);
      lastTime = t;
    }
    requestAnimationFrame(loop);
  }

  resize();
  window.addEventListener('resize', resize, { passive: true });

  // Cursor gravity: track mouse position for gentle node attraction
  if (gravityEnabled) {
    window.addEventListener('mousemove', (e: MouseEvent) => {
      cursorX = e.clientX;
      cursorY = e.clientY;
      lastCursorTime = performance.now();
      // Ramp influence up quickly
      cursorInfluence = Math.min(cursorInfluence + 0.1, 1);
    });
  }

  if (!reduceMotion) {
    requestAnimationFrame(loop);
  }
</script>
