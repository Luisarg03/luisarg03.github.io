---
import SectionPanel from '../layout/SectionPanel.astro';
import { experience } from '../../content/cv';

// ── Helpers ──────────────────────────────────────────────────────────────

function parseDate(dateStr: string): Date {
  const [m, y] = dateStr.split('/');
  return new Date(Number(y), Number(m) - 1);
}

function getYear(dateStr: string): number {
  return Number(dateStr.split('/')[1]);
}

function formatRange(start: string, end: string | null): string {
  return `${start} – ${end ?? 'Present'}`;
}

// ── Sort & group by year (descending) ────────────────────────────────────

const sorted = [...experience].sort(
  (a, b) => parseDate(b.startDate).getTime() - parseDate(a.startDate).getTime(),
);

interface YearGroup {
  year: number;
  entries: typeof experience;
}

const groups: YearGroup[] = [];
for (const entry of sorted) {
  const y = getYear(entry.startDate);
  const last = groups.at(-1);
  if (last && last.year === y) {
    last.entries.push(entry);
  } else {
    groups.push({ year: y, entries: [entry] });
  }
}
---

<SectionPanel title="Experience" id="experience">
  <div class="timeline min-h-[200px]">
    <!-- ═══════ SVG Spine Column (grid-col 1) ═══════ -->
    <div class="column-spine">
      <svg class="timeline-spine" viewBox="0 0 16 100" preserveAspectRatio="none" aria-hidden="true">
        <line
          x1="8" y1="0" x2="8" y2="2000"
          class="draw-on-scroll"
          stroke="var(--color-border-active)"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    </div>

    <!-- ═══════ Content Column (grid-col 2) ═══════ -->
    <div class="column-content">
      {groups.map((group, gi) => (
        <div class="year-group">
          <!-- Year marker (between groups only) -->
          {gi > 0 && (
            <div class="year-marker flex items-center gap-2 py-4" aria-hidden="true">
              <span class="font-mono text-xs text-[var(--color-text-muted)] opacity-60 tracking-widest select-none">
                ─── {group.year} ───
              </span>
            </div>
          )}

          {group.entries.map((job) => {
            const isCurrent = job.endDate === null;
            const hasMany = job.responsibilities.length > 4;
            const collapsible = !isCurrent && hasMany;
            const visibleCount = collapsible ? 3 : job.responsibilities.length;

            return (
              <div
                class:list={[
                  'entry relative pb-5 last:pb-0 reveal-on-view',
                  isCurrent && 'entry--current',
                ]}
              >
                <!-- Timeline node -->
                <span
                  class:list={[
                    'entry-node',
                    isCurrent
                      ? 'bg-[var(--color-success)] border-[var(--color-success)] status-dot status-dot--active'
                      : 'bg-[var(--color-bg)] border-[var(--color-border-active)]',
                  ]}
                  aria-hidden="true"
                ></span>

                <!-- Card -->
                <div
                  class:list={[
                    'entry-card rounded-lg border',
                    isCurrent
                      ? 'bg-[rgba(240,180,41,0.06)] border-[var(--color-border-active)] p-5'
                      : 'bg-[var(--color-surface)] border-[var(--color-border)] p-4',
                  ]}
                >
                  <!-- Header -->
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
                    <h3 class="text-[var(--text-base)] font-semibold text-[var(--color-text)]">
                      {job.role}
                    </h3>
                    {isCurrent && (
                      <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-success)] border border-[var(--color-success)] rounded px-1.5 py-0.5 bg-[rgba(63,185,80,0.08)]">
                        current
                      </span>
                    )}
                  </div>

                  <!-- Company + Location -->
                  <p class="text-[var(--text-sm)] text-[var(--color-accent)] mb-1">
                    {job.company}
                    <span class="text-[var(--color-text-muted)]">· {job.location}</span>
                  </p>

                  <!-- Date range -->
                  <p class="font-mono text-[var(--text-xs)] text-[var(--color-text-muted)] mb-3">
                    {formatRange(job.startDate, job.endDate)}
                  </p>

                  <!-- Responsibilities -->
                  <div class="resp-list" data-collapsible={collapsible || undefined}>
                    <ul class="list-none pl-0 space-y-1.5 text-[var(--text-sm)] text-[var(--color-text)]">
                      {job.responsibilities.slice(0, visibleCount).map((r) => (
                        <li class="relative pl-4">
                          <span class="absolute left-0 top-[0.6em] w-1.5 h-1.5 rounded-full bg-[var(--color-border-active)]" aria-hidden="true"></span>
                          {r}
                        </li>
                      ))}
                    </ul>

                    {collapsible && (
                      <>
                        <ul class="extra-resp list-none pl-0 space-y-1.5 text-[var(--text-sm)] text-[var(--color-text)] hidden">
                          {job.responsibilities.slice(visibleCount).map((r) => (
                            <li class="relative pl-4">
                              <span class="absolute left-0 top-[0.6em] w-1.5 h-1.5 rounded-full bg-[var(--color-border-active)]" aria-hidden="true"></span>
                              {r}
                            </li>
                          ))}
                        </ul>
                        <button
                          class="toggle-details font-mono text-xs text-[var(--color-accent)] mt-2 cursor-pointer hover:underline"
                          aria-expanded="false"
                        >
                          Show details
                        </button>
                      </>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</SectionPanel>

<noscript>
  <style>
    .timeline-spine line { stroke-dashoffset: 0; }
  </style>
</noscript>

<style>
  /* ── Grid-based timeline layout ─────────────────────────────────────── */
  .timeline {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 0.5rem;
  }

  .column-spine {
    grid-column: 1;
    grid-row: 1 / -1;
    position: relative;
    min-height: 100%;
  }

  .timeline-spine {
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .column-content {
    grid-column: 2;
  }

  /* ── Year marker ────────────────────────────────────────────────────── */
  .year-marker span {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* ── Entry node (spine column alignment via calc from grid) ─────────── */
  .entry-node {
    position: absolute;
    /* 16px spine + 0.5rem gap + centering offset */
    left: calc(-16px - 0.5rem + 2px);
    top: 0.375rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    border: 2px solid var(--color-border-active);
    background: var(--color-bg);
    z-index: 10;
  }

  .entry {
    position: relative;
  }

  .entry--current .entry-node {
    width: 0.875rem;
    height: 0.875rem;
    background: var(--color-success);
    border-color: var(--color-success);
  }

  /* Fallback for browsers without animation-timeline support */
  @supports not (animation-timeline: view()) {
    .timeline-spine line {
      stroke-dashoffset: 0;
    }
  }

  /* Mobile: < 640px */
  @media (max-width: 639px) {
    .timeline {
      grid-template-columns: 12px 1fr;
    }

    .entry-node {
      left: calc(-12px - 0.5rem + 2px);
      width: 0.625rem;
      height: 0.625rem;
    }

    .entry--current .entry-node {
      width: 0.75rem;
      height: 0.75rem;
    }

    .year-marker span {
      font-size: 0.625rem;
    }

    .year-marker {
      padding-top: 1rem;
      padding-bottom: 1rem;
    }
  }
</style>

<script>
  // Expand/collapse toggle — local per-entry state
  document.querySelectorAll('.toggle-details').forEach((btn) => {
    btn.addEventListener('click', () => {
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      const container = btn.closest('.resp-list');
      const extra = container?.querySelector('.extra-resp');
      if (!extra) return;

      if (expanded) {
        extra.classList.add('hidden');
        btn.textContent = 'Show details';
        btn.setAttribute('aria-expanded', 'false');
      } else {
        extra.classList.remove('hidden');
        btn.textContent = 'Hide details';
        btn.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
