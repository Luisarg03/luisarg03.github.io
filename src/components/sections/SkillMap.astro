---
import SectionPanel from '../layout/SectionPanel.astro';
import SkillGroupList from '../charts/SkillGroupList.astro';
import { skillCategories } from '../../content/cv';

const categoryAccents: Record<string, string> = {
  'Cloud & IaC': 'var(--color-accent)',
  'CI/CD & DevOps': 'var(--color-success)',
  'Data & Processing': 'var(--color-warning)',
  'Python Libraries': '#a371f7',
  'Databases': '#f97583',
  'Data Visualization': '#56d4dd',
  'Platform Engineering': 'var(--color-accent)',
  'AI Tooling': '#d2a8ff',
  'Web Dev': '#7ee787',
  'Languages': 'var(--color-text-muted)',
};
---

<SectionPanel title="Infrastructure" id="skills">
  <div class="skills-content reveal-on-view" id="skills-content" data-active-category="">
    <div class="skills-list-col">
      <SkillGroupList categories={skillCategories} categoryAccents={categoryAccents} />
    </div>
  </div>
</SectionPanel>

<style>
  .skills-content {
    display: block;
  }
</style>
