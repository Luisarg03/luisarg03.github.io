---
export interface Props {
  title?: string;
  id?: string;
  class?: string;
}

const { title, id, class: className = '' } = Astro.props;
---

<section id={id} class:list={['surface p-6 md:p-8 lg:p-10', className]}>
  {title && (
    <h2 class="section-label mb-4 pb-3 border-b border-[var(--color-border)]">
      {title}
    </h2>
  )}
  <slot />
</section>
