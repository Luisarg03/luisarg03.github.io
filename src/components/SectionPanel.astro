---
export interface Props {
  title?: string;
  id?: string;
  class?: string;
}

const { title, id, class: className = '' } = Astro.props;
---

<section id={id} class:list={['panel p-6 md:p-8 lg:p-10', className]}>
  {title && (
    <div class="flex items-center gap-3 mb-5 pb-3 border-b border-[var(--color-border)]">
      <h2 class="section-label mb-0">
        {title}
      </h2>
    </div>
  )}
  <slot />
</section>
