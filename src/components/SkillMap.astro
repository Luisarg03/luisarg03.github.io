---
import SectionPanel from './SectionPanel.astro';
import SkillRadar from './SkillRadar.astro';
import SkillGroupList from './SkillGroupList.astro';
import { skillCategories } from '../content/cv';

const categoryAccents: Record<string, string> = {
  'Cloud & IaC': 'var(--color-accent)',
  'CI/CD & DevOps': 'var(--color-success)',
  'Data & Processing': 'var(--color-warning)',
  'Python Libraries': '#a371f7',
  'Databases': '#f97583',
  'Data Visualization': '#56d4dd',
  'Platform Engineering': 'var(--color-accent)',
  'AI Tooling': '#d2a8ff',
  'Web Dev': '#7ee787',
  'Languages': 'var(--color-text-muted)',
};
---

<SectionPanel title="Infrastructure" id="skills">
  <div class="skills-content" id="skills-content" data-active-category="">
    <div class="skills-radar-col">
      <SkillRadar categories={skillCategories} />
    </div>
    <div class="skills-list-col">
      <SkillGroupList categories={skillCategories} categoryAccents={categoryAccents} />
    </div>
  </div>
</SectionPanel>

<script>
  (function () {
    var container = document.getElementById('skills-content');
    if (!container) return;

    // Listen for the custom event bubbling up from either child
    container.addEventListener('skill-category-focus', function (e) {
      var category = e.detail ? e.detail.category : null;

      if (category) {
        container.setAttribute('data-active-category', category);

        // Sync radar axis highlighting via data-category attributes
        var axes = container.querySelectorAll('[data-category]');
        for (var i = 0; i < axes.length; i++) {
          if (axes[i].getAttribute('data-category') === category) {
            axes[i].setAttribute('data-highlighted', '');
          } else {
            axes[i].removeAttribute('data-highlighted');
          }
        }
      } else {
        container.removeAttribute('data-active-category');

        var axes = container.querySelectorAll('[data-category]');
        for (var i = 0; i < axes.length; i++) {
          axes[i].removeAttribute('data-highlighted');
        }
      }
    });
  })();
</script>

<style>
  .skills-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .skills-content {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .skills-content {
      grid-template-columns: 1fr 2fr;
    }
  }

  /* Align tops */
  .skills-radar-col {
    align-self: start;
  }

  /* Radar axis highlighting via shared data-active-category */
  [data-category][data-highlighted] .radar-axis-hit {
    stroke: var(--color-accent-warm);
    stroke-opacity: 0.3;
  }

  /* When any category is active, dim non-active axes */
  .skills-content[data-active-category]:not([data-active-category=""])
    [data-category]:not([data-highlighted]) {
    opacity: 0.35;
    transition: opacity 0.25s ease;
  }
  .skills-content[data-active-category]:not([data-active-category=""])
    [data-category][data-highlighted] {
    opacity: 1;
  }
</style>
