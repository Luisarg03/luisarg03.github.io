---
/**
 * Card — shared card primitive for use across pages.
 *
 * Variants:
 *   - 'project' (default): border + surface bg + p-5 + top accent bar (visible on hover) + lift + shadow
 *   - 'status':            border + surface bg + p-4 + top accent bar (always visible) + no hover
 *
 * The base classes ('panel', 'card-accent-top') come from the
 * visual-system spec's "Panel border convention" requirement;
 * this component is a thin wrapper that adds the variant modifier
 * + slot-based content.
 */
interface Props {
  variant?: 'project' | 'status';
  class?: string;
  style?: string;
  [key: `data-${string}`]: string | number | boolean | undefined;
}

const { variant = 'project', class: className = '', style: styleAttr, ...rest } = Astro.props;

const baseClasses = ['panel', 'card-accent-top', `card--${variant}`];
if (className) baseClasses.push(className);
const classes = baseClasses.join(' ');
---

<div class={classes} style={styleAttr} {...rest}>
  <slot />
</div>

<style>
  /* ── Project variant: hover lift + shadow + top accent on hover ─────── */
  .card--project {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    transition: transform 200ms ease-out, box-shadow 200ms ease-out, border-color 200ms;
  }

  .card--project::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    opacity: 0;
    transition: opacity 200ms ease-out;
  }

  .card--project:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(240, 180, 41, 0.08);
  }

  .card--project:hover::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .card--project,
    .card--project::before,
    .card--project:hover,
    .card--project:hover::before {
      transition: none;
      transform: none;
    }
  }

  /* ── Status variant: compact, always-visible top accent ───────────────── */
  .card--status {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: var(--space-4);
  }

  .card--status::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-accent);
    opacity: 1;
  }
</style>
