---
// Blueprint grid background — procedural canvas island.
// Honours prefers-reduced-motion: falls back to a single static frame.
---

<canvas
  id="blueprint-grid"
  class="fixed inset-0 w-full h-full pointer-events-none z-0"
  aria-hidden="true"
></canvas>

<script>
  const canvas = document.getElementById('blueprint-grid') as HTMLCanvasElement | null;
  if (!canvas) throw new Error('blueprint-grid canvas not found');
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('2d context unavailable');

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Configuration
  const GRID_MAJOR = 80;   // major grid spacing (px)
  const GRID_MINOR = 20;   // minor grid spacing (px)
  const DPR_CAP = 2;
  const PULSE_SPEED = 0.0008; // ms per pixel
  const NODE_COUNT = 12;

  type Node = { x: number; y: number; vx: number; vy: number };
  let nodes: Node[] = [];
  let width = 0;
  let height = 0;
  let dpr = 1;
  let lastTime = 0;

  function seedNodes() {
    nodes = Array.from({ length: NODE_COUNT }, () => ({
      x: Math.random() * width,
      y: Math.random() * height,
      vx: (Math.random() - 0.5) * 0.15,
      vy: (Math.random() - 0.5) * 0.15,
    }));
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, DPR_CAP);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas!.width = Math.floor(width * dpr);
    canvas!.height = Math.floor(height * dpr);
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    seedNodes();
    if (reduceMotion) render(0);
  }

  function drawGrid() {
    const minor = 'rgba(120, 145, 180, 0.05)';
    const major = 'rgba(120, 145, 180, 0.10)';
    ctx!.strokeStyle = minor;
    ctx!.lineWidth = 1;
    ctx!.beginPath();
    for (let x = 0; x < width; x += GRID_MINOR) {
      ctx!.moveTo(x, 0);
      ctx!.lineTo(x, height);
    }
    for (let y = 0; y < height; y += GRID_MINOR) {
      ctx!.moveTo(0, y);
      ctx!.lineTo(width, y);
    }
    ctx!.stroke();

    ctx!.strokeStyle = major;
    ctx!.lineWidth = 1;
    ctx!.beginPath();
    for (let x = 0; x < width; x += GRID_MAJOR) {
      ctx!.moveTo(x, 0);
      ctx!.lineTo(x, height);
    }
    for (let y = 0; y < height; y += GRID_MAJOR) {
      ctx!.moveTo(0, y);
      ctx!.lineTo(width, y);
    }
    ctx!.stroke();
  }

  function drawNodes(t: number) {
    for (const n of nodes) {
      n.x += n.vx;
      n.y += n.vy;
      if (n.x < 0 || n.x > width) n.vx *= -1;
      if (n.y < 0 || n.y > height) n.vy *= -1;

      const phase = (t * PULSE_SPEED + (n.x + n.y) * 0.01) % 1;
      const radius = 1.5 + phase * 2.5;
      const alpha = 0.3 + phase * 0.5;

      ctx!.beginPath();
      ctx!.arc(n.x, n.y, radius, 0, Math.PI * 2);
      ctx!.fillStyle = `rgba(88, 166, 255, ${alpha})`;
      ctx!.fill();
    }
  }

  function drawTraces() {
    // Connect nearby nodes with subtle lines, with a pulse traveling along them
    for (let i = 0; i < nodes.length; i++) {
      for (let j = i + 1; j < nodes.length; j++) {
        const a = nodes[i];
        const b = nodes[j];
        const dx = a.x - b.x;
        const dy = a.y - b.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const MAX = 220;
        if (dist > MAX) continue;
        const alpha = (1 - dist / MAX) * 0.15;
        ctx!.strokeStyle = `rgba(88, 166, 255, ${alpha})`;
        ctx!.lineWidth = 1;
        ctx!.beginPath();
        ctx!.moveTo(a.x, a.y);
        ctx!.lineTo(b.x, b.y);
        ctx!.stroke();
      }
    }
  }

  function render(t: number) {
    ctx!.clearRect(0, 0, width, height);
    drawGrid();
    drawTraces();
    drawNodes(t);
  }

  function loop(t: number) {
    if (reduceMotion) return;
    if (t - lastTime > 16) {
      render(t);
      lastTime = t;
    }
    requestAnimationFrame(loop);
  }

  resize();
  window.addEventListener('resize', resize, { passive: true });
  if (!reduceMotion) {
    requestAnimationFrame(loop);
  }
</script>
