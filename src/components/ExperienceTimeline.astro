---
import SectionPanel from './SectionPanel.astro';
import { experience } from '../content/cv';

function formatRange(start: string, end: string | null): string {
  return `${start} – ${end ?? 'Present'}`;
}
---

<SectionPanel title="Experience" id="experience">
  <ol class="relative pl-8">
    <span
      class="absolute left-3 top-2 bottom-2 w-px bg-[var(--color-border)]"
      aria-hidden="true"
    ></span>
    {experience.map((job) => {
      const isCurrent = job.endDate === null;
      return (
        <li class="relative mb-10 last:mb-0">
          <span
            class:list={[
              'absolute -left-[1.45rem] top-1.5 w-3 h-3 rounded-full border-2',
              isCurrent
                ? 'bg-[var(--color-success)] border-[var(--color-success)] shadow-[0_0_0_4px_rgba(63,185,80,0.2)]'
                : 'bg-[var(--color-bg)] border-[var(--color-border-active)]',
            ]}
            aria-hidden="true"
          ></span>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
            <h3 class="text-base font-semibold text-[var(--color-text)]">
              {job.role}
            </h3>
            {isCurrent && (
              <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-success)] border border-[var(--color-success)] rounded px-1.5 py-0.5">
                current
              </span>
            )}
          </div>
          <p class="text-sm text-[var(--color-accent)] mb-1">
            {job.company} <span class="text-[var(--color-text-muted)]">· {job.location}</span>
          </p>
          <p class="font-mono text-xs text-[var(--color-text-muted)] mb-3">
            {formatRange(job.startDate, job.endDate)}
          </p>
          <ul class="list-disc pl-5 space-y-1.5 text-sm text-[var(--color-text)]">
            {job.responsibilities.map((r) => <li>{r}</li>)}
          </ul>
        </li>
      );
    })}
  </ol>
</SectionPanel>
