---
import SectionPanel from './SectionPanel.astro';
import { experience } from '../content/cv';

function formatRange(start: string, end: string | null): string {
  return `${start} – ${end ?? 'Present'}`;
}
---

<SectionPanel title="Experience" id="experience">
  <ol class="relative pl-8">
    <!-- Timeline spine -->
    <span
      class="absolute left-3 top-2 bottom-2 w-px"
      aria-hidden="true"
    >
      <span class="block w-full h-full bg-gradient-to-b from-[var(--color-border-active)] via-[var(--color-border)] to-transparent"></span>
    </span>

    {experience.map((job, i) => {
      const isCurrent = job.endDate === null;
      return (
        <li class:list={[
          'relative mb-10 last:mb-0',
          isCurrent && 'pl-4 -ml-4 py-4 -mx-4 px-4 rounded-lg bg-[var(--color-accent-glow)] border border-[var(--color-border-active)]',
        ]}>
          <!-- Timeline node -->
          <span
            class:list={[
              'absolute -left-[1.45rem] top-1.5 w-3 h-3 rounded-full border-2 z-10',
              isCurrent
                ? 'bg-[var(--color-success)] border-[var(--color-success)] shadow-[0_0_0_4px_rgba(63,185,80,0.2),0_0_12px_rgba(63,185,80,0.3)]'
                : 'bg-[var(--color-bg)] border-[var(--color-border-active)]',
            ]}
            aria-hidden="true"
          ></span>

          <!-- Role header -->
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
            <h3 class:list={[
              'text-[var(--text-base)] font-semibold',
              isCurrent ? 'text-[var(--color-text)]' : 'text-[var(--color-text)]',
            ]}>
              {job.role}
            </h3>
            {isCurrent && (
              <span class="font-mono text-[10px] uppercase tracking-wider text-[var(--color-success)] border border-[var(--color-success)] rounded px-1.5 py-0.5 bg-[rgba(63,185,80,0.08)]">
                current
              </span>
            )}
          </div>

          <!-- Company + Location -->
          <p class="text-[var(--text-sm)] text-[var(--color-accent)] mb-1">
            {job.company} <span class="text-[var(--color-text-muted)]">· {job.location}</span>
          </p>

          <!-- Date range -->
          <p class="font-mono text-[var(--text-xs)] text-[var(--color-text-muted)] mb-3">
            {formatRange(job.startDate, job.endDate)}
          </p>

          <!-- Responsibilities -->
          <ul class="list-none pl-0 space-y-1.5 text-[var(--text-sm)] text-[var(--color-text)]">
            {job.responsibilities.map((r) => (
              <li class="relative pl-4">
                <span class="absolute left-0 top-[0.6em] w-1.5 h-1.5 rounded-full bg-[var(--color-border-active)]" aria-hidden="true"></span>
                {r}
              </li>
            ))}
          </ul>
        </li>
      );
    })}
  </ol>
</SectionPanel>
