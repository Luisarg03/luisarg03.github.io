---
import StatusIndicator from './StatusIndicator.astro';

export interface Props {
  label: string;
  value: string;
  status?: 'active' | 'in-progress' | 'planned' | 'offline';
  class?: string;
}

const { label, value, status, class: className = '' } = Astro.props;
---

<div class:list={[
  'panel card-accent-top p-4 min-w-0 glow-hover',
  className,
]}>
  <span class="block font-mono text-[var(--text-xs)] uppercase tracking-wider text-[var(--color-text-muted)] mb-2">
    {label}
  </span>
  <span class="block text-[var(--text-lg)] font-semibold text-[var(--color-text)] leading-tight">
    {status && <StatusIndicator status={status} class="mr-1.5 inline-block align-middle" />}
    {value}
  </span>
</div>
