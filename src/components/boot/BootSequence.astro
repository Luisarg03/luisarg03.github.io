<div id="boot-sequence" class="boot-sequence"></div>

<script>
  const bootEl = document.getElementById('boot-sequence')!;
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReducedMotion) {
    bootEl.dispatchEvent(new CustomEvent('boot-complete'));
  } else {
    const frames = [
      '[    0.000000] Booting LuisOS v7.0.0 — luis@arch',
      '[    0.154200] CPU: Arch x86_64 (4 cores @ 3.4GHz)',
      '[    0.423100] Memory: 64GB RAM detected — swap: 8GB',
      '[    0.891300] Kernel: linux-arch 6.6.0 loaded',
      '[    1.245000] Starting system services...',
      '[    1.512400] [  OK  ] Started OpenSSH Daemon',
      '[    1.890200] [  OK  ] Started Hyprland Compositor',
      '[    2.134500] [  OK  ] Reached target Multi-User System.',
    ];

    const FRAME_DELAY = 250;
    let frameIndex = 0;
    let skipped = false;

    function showNextFrame() {
      if (skipped) return;
      if (frameIndex >= frames.length) {
        finish();
        return;
      }
      const line = document.createElement('div');
      line.className = 'boot-line';
      line.textContent = frames[frameIndex];
      bootEl.appendChild(line);
      bootEl.scrollTop = bootEl.scrollHeight;
      frameIndex++;
      setTimeout(showNextFrame, FRAME_DELAY);
    }

    function skip() {
      if (skipped) return;
      skipped = true;
      while (frameIndex < frames.length) {
        const line = document.createElement('div');
        line.className = 'boot-line';
        line.textContent = frames[frameIndex];
        bootEl.appendChild(line);
        frameIndex++;
      }
      finish();
    }

    function finish() {
      setTimeout(() => {
        bootEl.dispatchEvent(new CustomEvent('boot-complete'));
      }, 200);
    }

    document.addEventListener('keydown', () => skip(), { once: true });
    document.addEventListener('click', () => skip(), { once: true });
    document.addEventListener('touchstart', () => skip(), { once: true });

    showNextFrame();
  }
</script>

<style>
  .boot-sequence {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .boot-line {
    animation: boot-fade-in 0.15s ease-out;
  }

  @keyframes boot-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .boot-line {
      animation: none;
    }
  }
</style>