---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BlueprintGrid from '../components/layout/BlueprintGrid.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Cloud Engineer — building platforms, pipelines, and infrastructure that lasts.' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isNow = Astro.url.pathname === '/now';
const ogImageURL = `${canonicalURL.origin}/monogram.svg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <ClientRouter />
  </head>
  <body class="min-h-screen relative" aria-keyshortcuts="Meta+K Control+K">
    <!-- ponytail: transition:animate="none" prevents BlueprintGrid canvas state glitching mid-flight -->
    <BlueprintGrid transition:animate="none" />

    <!-- Vertical connector line (desktop only) -->
    <div class="vertical-connector" aria-hidden="true"></div>

    <!-- Control Panel Header -->
    <header class="relative z-10 border-b border-[var(--color-border)] bg-[var(--color-bg)]/90 backdrop-blur-md sticky top-0">
      <div class="h-[2px] bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-40"></div>

      <nav class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-mono text-sm tracking-wider text-[var(--color-accent)] hover:text-[var(--color-text)] transition-colors group">
          <span class="w-2 h-2 rounded-full bg-[var(--color-success)] group-hover:shadow-[0_0_8px_var(--color-success-glow)] transition-shadow" aria-hidden="true"></span>
          <span>~/luisarg</span>
        </a>

        <ul class="flex items-center gap-1 text-sm font-mono">
          <li>
            <a
              href="/"
              class:list={[
                'px-3 py-1.5 rounded transition-colors',
                !isNow
                  ? 'text-[var(--color-text)] bg-[var(--color-surface-alt)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)]',
              ]}
            >
              index
            </a>
          </li>
          <li>
            <a
              href="/now"
              class:list={[
                'px-3 py-1.5 rounded transition-colors flex items-center gap-1.5',
                isNow
                  ? 'text-[var(--color-text)] bg-[var(--color-surface-alt)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)]',
              ]}
            >
              /now
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] status-dot status-dot--active" aria-hidden="true"></span>
            </a>
          </li>
          <li class="w-px h-4 bg-[var(--color-border)] mx-1" aria-hidden="true"></li>
          <li>
            <a
              href="https://github.com/luisarg03"
              target="_blank"
              rel="noopener"
              class="px-3 py-1.5 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              github ↗
            </a>
          </li>
          <li>
            <a
              href="https://linkedin.com/in/luisarg03"
              target="_blank"
              rel="noopener"
              class="px-3 py-1.5 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              linkedin ↗
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main class="relative z-10 max-w-6xl mx-auto px-6 py-6 md:py-8 lg:py-10">
      <!-- TODO(lane 3): add transition:name="hero-block" to the hero <section> in Hero.astro -->
      <slot />
    </main>

    <!-- Footer — system status bar -->
    <footer class="relative z-10 border-t border-[var(--color-border)] mt-6 md:mt-8">
      <div class="h-px bg-gradient-to-r from-transparent via-[var(--color-border-active)] to-transparent"></div>

      <!-- Dynamic status row: section, scroll progress, local time -->
      <div
        id="status-bar"
        class="flex items-center justify-between max-w-6xl mx-auto px-6 py-2 border-b border-[var(--color-border)]/50 font-mono text-[var(--text-xs)] text-[var(--color-text-muted)]"
      >
        <div class="flex items-center gap-3">
          <span id="status-section" class="text-[var(--color-accent)]">section: —</span>
          <span class="text-[var(--color-border)]" aria-hidden="true">|</span>
          <span id="status-scroll">0%</span>
        </div>
        <div>
          <span id="status-time">--:--</span>
          <span class="text-[var(--color-border)] mx-2" aria-hidden="true">·</span>
          <span class="text-[var(--color-text-muted)]/60">UTC</span>
        </div>
      </div>

      <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-3 text-[var(--text-xs)] font-mono text-[var(--color-text-muted)]">
        <div class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] status-dot status-dot--active" aria-hidden="true"></span>
          <span class="text-[var(--color-success)]">SYSTEM STATUS: ONLINE</span>
          <span class="text-[var(--color-border)]">·</span>
          <span>© 2026 Luis Meyehen Paz</span>
          <span class="text-[var(--color-border)]">·</span>
          <a
            href="/terminal"
            class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-[var(--color-border)] text-[var(--color-text-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors"
            title="Open terminal"
          >
            <span class="text-[var(--color-accent)]">$</span> terminal
          </a>
        </div>
        <div class="flex items-center gap-3">
          <span>astro</span>
          <span class="text-[var(--color-border)]">·</span>
          <span>github pages</span>
          <span class="text-[var(--color-border)]">·</span>
          <span class="text-[var(--color-accent)] border border-[var(--color-border-active)] rounded px-2 py-0.5">v1.0.0</span>
        </div>
      </div>
    </footer>

    <!-- Command palette mount -->
    <div id="command-palette-root">
      <CommandPalette />
    </div>

    <!-- Status bar: section, scroll progress, local time (rAF-throttled) -->
    <script is:inline src="/scripts/status-bar.js"></script>

    <!-- Scroll reveal: IntersectionObserver for .reveal / .reveal-on-view* / .draw-on-scroll -->
    <script is:inline src="/scripts/scroll-observer.js"></script>

    <!-- Scroll velocity tracker: sets --scroll-velocity for blueprint background -->
    <script is:inline src="/scripts/velocity-tracker.js"></script>
  </body>
</html>
