---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BlueprintGrid from '../components/layout/BlueprintGrid.astro';
import CommandPalette from '../components/ui/CommandPalette.astro';

export interface Props {
  title: string;
  description?: string;
  hideFooter?: boolean;
  /** Homepage only: shows the `[LOADED]` boot indicator chip in the header. */
  showBootChip?: boolean;
}

const { title, description = 'Cloud Engineer — building platforms, pipelines, and infrastructure that lasts.', hideFooter = false, showBootChip = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isNow = Astro.url.pathname === '/now';
const isProjects = Astro.url.pathname === '/projects' || Astro.url.pathname.startsWith('/projects/');
const isIndex = !isNow && !isProjects;
const ogImageURL = `${canonicalURL.origin}/og-default.png`;

const buildCommit = (import.meta.env as any).VITE_BUILD_COMMIT ?? process.env.VITE_BUILD_COMMIT ?? 'unknown';
const buildDate = (import.meta.env as any).VITE_BUILD_DATE ?? process.env.VITE_BUILD_DATE ?? 'unknown';
const buildUptime = (import.meta.env as any).VITE_BUILD_UPTIME_DAYS ?? process.env.VITE_BUILD_UPTIME_DAYS ?? '?d';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      name: 'Luis Meyehen Paz',
      url: 'https://luisarg03.github.io',
      jobTitle: 'Cloud Engineer',
      sameAs: [
        'https://github.com/luisarg03',
        'https://linkedin.com/in/luisarg03',
      ],
      image: `${canonicalURL.origin}/og-default.png`,
    },
    {
      '@type': 'WebSite',
      name: '~/luisarg',
      url: 'https://luisarg03.github.io',
      description: 'Cloud Engineer — building platforms, pipelines, and infrastructure that lasts.',
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="color-scheme" content="dark" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:site" content="@luisarg03" />
    <meta name="twitter:creator" content="@luisarg03" />
    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  </head>
  <body class="min-h-screen relative" aria-keyshortcuts="Meta+K Control+K">
    <!-- ponytail: transition:animate="none" prevents BlueprintGrid canvas state glitching mid-flight -->
    <BlueprintGrid transition:animate="none" />

    <!-- Vertical connector line (desktop only) -->
    <div class="vertical-connector" aria-hidden="true"></div>

    <!-- Control Panel Header -->
    <header class="relative z-30 border-b border-[var(--color-border)] bg-[var(--color-bg)] sticky top-0" transition:name="site-header">
      <div class="h-[2px] bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-40"></div>

      <nav class="max-w-6xl mx-auto px-6 py-3 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2 font-mono text-sm tracking-wider text-[var(--color-accent-identity)] hover:text-[var(--color-text)] transition-colors group">
            <span class="w-2 h-2 rounded-full bg-[var(--color-success)] group-hover:shadow-[0_0_8px_var(--color-success-glow)] transition-shadow" aria-hidden="true"></span>
            <span>~/luisarg</span>
          </a>

          <!-- Boot loaded indicator (homepage only). Statically visible: the
               opaque boot overlay covers it during play, the fade reveals it —
               no JS wiring needed, and no-JS/reduced-motion/quick-mode all
               show it immediately. -->
          {showBootChip && (
            <span class="hidden md:inline-flex items-center gap-1.5 font-mono text-xs tracking-wider border border-[var(--color-border)] rounded px-2 py-1" aria-hidden="true">
              <span class="text-[var(--color-accent)]">◆</span>
              <span class="text-[var(--color-success)]">[LOADED] LuisOS v7.0.0</span>
            </span>
          )}
        </div>

        <ul class="flex items-center gap-1 text-sm font-mono">
          <li>
            <a
              href="/"
              class:list={[
                'px-3 py-1.5 rounded transition-colors',
                isIndex
                  ? 'text-[var(--color-text)] bg-[var(--color-surface-alt)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)]',
              ]}
            >
              index
            </a>
          </li>
          <li>
            <a
              href="/now"
              class:list={[
                'px-3 py-1.5 rounded transition-colors flex items-center gap-1.5',
                isNow
                  ? 'text-[var(--color-text)] bg-[var(--color-surface-alt)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)]',
              ]}
            >
              /now
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-success)] status-dot status-dot--active" aria-hidden="true"></span>
            </a>
          </li>
          <li>
            <a
              href="/projects"
              class:list={[
                'px-3 py-1.5 rounded transition-colors',
                isProjects
                  ? 'text-[var(--color-text)] bg-[var(--color-surface-alt)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)]',
              ]}
            >
              /projects
            </a>
          </li>
          <li class="w-px h-4 bg-[var(--color-border)] mx-1 hidden sm:block" aria-hidden="true"></li>
          <li class="hidden sm:block">
            <a
              href="https://github.com/luisarg03"
              target="_blank"
              rel="noopener"
              class="px-3 py-1.5 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              github ↗
            </a>
          </li>
          <li class="hidden sm:block">
            <a
              href="https://linkedin.com/in/luisarg03"
              target="_blank"
              rel="noopener"
              class="px-3 py-1.5 rounded text-[var(--color-text-muted)] hover:text-[var(--color-text)] hover:bg-[var(--color-surface-alt)] transition-colors"
            >
              linkedin ↗
            </a>
          </li>
        </ul>
      </nav>
    </header>

    <main class="relative z-10 max-w-6xl mx-auto px-6 py-6 md:py-8 lg:py-10" transition:name="main">
      <slot />
    </main>

    <!-- Footer (hidden on homepage where ShutdownModule replaces it) -->
    {!hideFooter && (
    <footer class="site-terminal-footer">
      <hr class="site-terminal-footer__divider" aria-hidden="true" />

      <p class="site-terminal-footer__prompt">$ luisarg@cloud:~$ ▮</p>

      <hr class="site-terminal-footer__divider" aria-hidden="true" />

      <p class="site-terminal-footer__links">
        <a href="/" class="site-terminal-footer__link">home</a>
        <span class="site-terminal-footer__sep" aria-hidden="true">·</span>
        <a href="/projects" class="site-terminal-footer__link">projects</a>
        <span class="site-terminal-footer__sep" aria-hidden="true">·</span>
        <a href="/now" class="site-terminal-footer__link">now</a>
        <span class="site-terminal-footer__sep" aria-hidden="true">·</span>
        <a href="https://github.com/luisarg03" target="_blank" rel="noopener" class="site-terminal-footer__link">github</a>
        <span class="site-terminal-footer__sep" aria-hidden="true">·</span>
        <a href="https://linkedin.com/in/luisarg03" target="_blank" rel="noopener" class="site-terminal-footer__link">linkedin</a>
        <span class="site-terminal-footer__sep" aria-hidden="true">·</span>
        <a href="mailto:luis.m.paz.03@gmail.com" class="site-terminal-footer__link">email</a>
      </p>

      <hr class="site-terminal-footer__divider" aria-hidden="true" />

      <p class="site-terminal-footer__build">
        commit <span class="site-terminal-footer__build-val">{buildCommit}</span> · uptime {buildUptime}d · {buildDate}
      </p>

      <p class="site-terminal-footer__copy">
        <span class="site-terminal-footer__status-dot" aria-hidden="true"></span>
        <span>© 2026 Luis Meyehen Paz</span>
      </p>
    </footer>
    )}

    <!-- Command palette mount -->
    <div id="command-palette-root">
      <CommandPalette />
    </div>

    <!-- Scroll reveal: IntersectionObserver for .reveal / .reveal-on-view* / .draw-on-scroll -->
    <script defer src="/scripts/scroll-observer.js"></script>

    <!-- Code copy: per-code-block copy button for prose content -->
    <script defer src="/scripts/copy-code.js"></script>
  </body>
</html>

<style>
  /* ── Terminal-style site footer (minimal horizontal) ──────────────────── */
  .site-terminal-footer {
    border-top: 1px solid var(--color-border);
    margin: var(--space-12) auto 0;
    padding: var(--space-6) var(--space-4) var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    max-width: 52rem;
    overflow-x: hidden;
    box-sizing: border-box;
    text-align: center;
  }

  .site-terminal-footer__divider {
    border: 0;
    border-top: 1px dashed var(--color-border);
    margin: var(--space-3) auto;
    max-width: 60%;
    opacity: 0.4;
  }

  .site-terminal-footer__prompt {
    color: var(--color-text-muted);
    margin: var(--space-2) 0 var(--space-3);
    opacity: 0.8;
  }

  .site-terminal-footer__links {
    margin: var(--space-3) 0;
    line-height: 1.6;
  }

  .site-terminal-footer__sep {
    color: var(--color-text-muted);
    opacity: 0.5;
    user-select: none;
  }

  .site-terminal-footer__link {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s;
  }

  .site-terminal-footer__link:hover {
    color: var(--color-accent);
  }

  .site-terminal-footer__build {
    margin: var(--space-2) 0;
    opacity: 0.7;
  }

  .site-terminal-footer__build-val {
    color: var(--color-accent);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .site-terminal-footer__copy {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    opacity: 0.8;
  }

  .site-terminal-footer__status-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent-identity);
  }
</style>
